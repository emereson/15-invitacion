---
// src/components/PadresPadrinos.astro
---

<section
  class="relative w-full py-16 flex justify-center items-center bg-gray-50 overflow-hidden px-4 md:px-8"
>
  <div
    class="relative z-10 w-full max-w-6xl mx-auto flex flex-col md:flex-row gap-10 md:gap-0"
  >
    {/* 🟢 COLUMNA DE LA IMAGEN */}
    <div
      class="w-full md:w-1/2 relative h-[55dvh] md:h-auto overflow-hidden group rounded-3xl md:rounded-l-3xl md:rounded-r-none shadow-xl md:shadow-none z-10 scroll-reveal"
    >
      <img
        src="/img/03.webp"
        alt="Maya"
        class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105"
      />
      <div
        class="absolute inset-0 shadow-[inset_0_-20px_20px_-20px_rgba(0,0,0,0.3)] md:shadow-none"
      >
      </div>
    </div>

    {/* 🟢 COLUMNA DE TEXTO */}
    <div
      class="w-full md:w-1/2 relative px-6 py-16 md:p-16 flex flex-col justify-center items-center text-center rounded-3xl md:rounded-r-3xl md:rounded-l-none shadow-sm md:shadow-none"
    >
      {/* Fondo de la Hoja */}
      <div
        class="absolute inset-0 bg-[url('/img/hoja.webp')] bg-repeat bg-cover bg-center bg-white/75 backdrop-blur-[2px] rounded-3xl md:rounded-r-3xl md:rounded-l-none overflow-hidden z-0 scroll-reveal"
      >
      </div>

      {/* 🟢 DECORACIÓN: FLORES (Con scroll-reveal y delays) */}
      <img
        src="/img/flor.webp"
        alt="Flor"
        class="absolute -top-12 -left-12 w-40 md:w-56 rotate-[135deg] animate-sway pointer-events-none z-20 scroll-reveal delay-300"
      />
      <img
        src="/img/flor.webp"
        alt="Flor"
        class="absolute -bottom-12 -right-12 w-40 md:w-56 -rotate-[45deg] animate-sway-delayed pointer-events-none z-20 scroll-reveal delay-500"
      />

      {/* 🟢 DECORACIÓN: ROSAS */}
      <img
        src="/img/rosa2.webp"
        alt="Rosa"
        class="absolute -top-8 -right-8 w-28 md:w-36 rotate-[15deg] animate-sway-delayed pointer-events-none z-20 scroll-reveal delay-400"
      />
      <img
        src="/img/rosa2.webp"
        alt="Rosa"
        class="absolute -bottom-8 -left-8 w-28 md:w-36 -rotate-[120deg] animate-sway pointer-events-none z-20 scroll-reveal delay-600"
      />

      {/* CONTENIDO DE TEXTO */}
      <div class="relative z-10 w-full flex flex-col items-center">
        <div class="scroll-reveal flex flex-col items-center">
          <h3
            class="font-script text-5xl md:text-6xl text-[#D4AF37] mb-2 drop-shadow-sm"
          >
            Mis Padres
          </h3>
          <p
            class="font-elegante text-2xl md:text-3xl text-slate-700 font-medium tracking-wide mt-4"
          >
            Carlos Ruiz
          </p>
          <p
            class="font-elegante text-lg md:text-xl text-[#D4AF37] italic my-1"
          >
            &
          </p>
          <p
            class="font-elegante text-2xl md:text-3xl text-slate-700 font-medium tracking-wide"
          >
            Graciana Castellanos
          </p>
        </div>

        <div class="w-full flex justify-center my-10 scroll-reveal">
          <svg
            width="80"
            height="15"
            viewBox="0 0 60 15"
            fill="none"
            stroke="#D4AF37"
            stroke-width="1.5"
            class="opacity-60"
          >
            <path
              d="M30 2L35 7.5L30 13L25 7.5Z"
              fill="#D4AF37"
              fill-opacity="0.2"></path>
            <line x1="0" y1="7.5" x2="20" y2="7.5"></line>
            <line x1="40" y1="7.5" x2="60" y2="7.5"></line>
          </svg>
        </div>

        <div class="scroll-reveal flex flex-col items-center">
          <h3
            class="font-script text-5xl md:text-6xl text-[#D4AF37] mb-2 drop-shadow-sm"
          >
            Mis Padrinos
          </h3>
          <p
            class="font-elegante text-2xl md:text-3xl text-slate-700 font-medium tracking-wide mt-4"
          >
            Mario Baez
          </p>
          <p
            class="font-elegante text-lg md:text-xl text-[#D4AF37] italic my-1"
          >
            &
          </p>
          <p
            class="font-elegante text-2xl md:text-3xl text-slate-700 font-medium tracking-wide"
          >
            Jessica Baez-Restrepo
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* 🟢 ANIMACIÓN DE REVELADO */
  .scroll-reveal {
    opacity: 0;
    transform: translateY(30px);
    transition: all 1s cubic-bezier(0.25, 0.8, 0.25, 1);
  }

  /* Animación especial para flores: combina escala y entrada */
  img.scroll-reveal {
    transform: scale(0.8) translateY(20px);
  }

  .scroll-reveal.active {
    opacity: 1;
    transform: translateY(0) scale(1) !important;
  }

  /* Delays para que las flores aparezcan después del texto */
  .delay-300 {
    transition-delay: 0.3s;
  }
  .delay-400 {
    transition-delay: 0.4s;
  }
  .delay-500 {
    transition-delay: 0.5s;
  }
  .delay-600 {
    transition-delay: 0.6s;
  }

  /* 🟢 BALANCEO */
  .animate-sway {
    animation: sway 7s ease-in-out infinite;
  }
  .animate-sway-delayed {
    animation: sway 8s ease-in-out 3s infinite reverse;
  }

  @keyframes sway {
    0%,
    100% {
      transform: translateY(0) rotate(var(--tw-rotate, 0deg));
    }
    50% {
      transform: translateY(-8px) rotate(calc(var(--tw-rotate, 0deg) + 4deg));
    }
  }
</style>

<script>
  function initScrollReveal() {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("active");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 },
    );

    document
      .querySelectorAll(".scroll-reveal")
      .forEach((el) => observer.observe(el));
  }
  document.addEventListener("DOMContentLoaded", initScrollReveal);
</script>
