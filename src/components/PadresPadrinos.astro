---
// src/components/PadresPadrinos.astro
---

<section
  class="relative w-full py-16 flex justify-center items-center bg-slate-50 overflow-hidden px-4 md:px-8"
>
  {/* 🟢 CONTENEDOR PRINCIPAL UNIFICADO */}
  <div
    class="relative z-10 w-full max-w-6xl mx-auto flex flex-col md:flex-row gap-16 md:gap-0
    md:border md:border-[#D4AF37] md:rounded-[2.5rem] md:shadow-[0_20px_50px_rgba(0,0,0,0.4)]
    transition-all duration-700 md:hover:shadow-[0_0_40px_rgba(212,175,55,0.25)]"
  >
    {/* 🟢 COLUMNA DE LA IMAGEN (Izquierda en desktop) */}
    <div
      class="relative w-full md:w-1/2 min-h-160 md:min-h-0 h-[55dvh] md:h-auto z-20 scroll-reveal
      border border-[#D4AF37] rounded-3xl md:border-none md:rounded-none"
    >
      {/* ENVOLTURA DE LA IMAGEN (overflow-hidden) */}
      <div
        class="absolute inset-0 overflow-hidden rounded-3xl md:rounded-none md:rounded-l-[2.5rem] shadow-[0_15px_30px_rgba(0,0,0,0.5)] md:shadow-none"
      >
        <img
          src="/img/1.webp"
          alt="Maya"
          class="w-full h-full object-cover transition-transform duration-1000 hover:scale-105"
        />
        {/* Sombra interna para fusionar con el lado derecho */}
        <div
          class="absolute inset-0 shadow-[inset_0_-40px_40px_-20px_rgba(2,6,23,0.8)] md:shadow-[inset_-30px_0_40px_-30px_rgba(2,6,23,0.9)] pointer-events-none"
        >
        </div>
      </div>

      {/* 🌸 FLOR IZQUIERDA (Sobresale de la imagen) */}
      <img
        src="/img/flor.webp"
        alt="Flor Decorativa"
        class="absolute -bottom-10 -left-10 w-40 max-md:hidden md:w-56 rotate-15 animate-sway-delayed pointer-events-none z-30 scroll-reveal delay-500 opacity-90 drop-shadow-[0_10px_15px_rgba(0,0,0,0.6)]"
      />
    </div>

    {/* 🟢 COLUMNA DE TEXTO (Derecha en desktop) */}
    <div
      class="relative w-full md:w-1/2 min-h-160 px-6 py-16 md:min-h-200 md:p-12 lg:p-16 flex flex-col justify-center items-center text-center z-10
      border border-[#D4AF37] rounded-3xl md:border-none md:rounded-none"
    >
      {/* Fondo Azul Noche Translúcido */}
      <div
        class="absolute inset-0 bg-[#0a111e]/50 backdrop-blur-xl rounded-3xl md:rounded-none md:rounded-r-[2.5rem] overflow-hidden z-0 md:shadow-[inset_20px_0_40px_-20px_rgba(2,6,23,0.9)]"
      >
        <div
          class="absolute inset-0 bg-[url('/img/hoja.webp')] bg-repeat bg-cover bg-center mix-blend-overlay"
        >
        </div>
      </div>

      {/* 🌸 FLORES DERECHAS (Arriba y abajo) */}
      <img
        src="/img/flor.webp"
        alt="Flor"
        class="absolute -top-12 -right-14 w-36 md:w-52 -rotate-135 animate-sway pointer-events-none z-30 scroll-reveal delay-300 opacity-90 drop-shadow-[0_10px_15px_rgba(0,0,0,0.6)]"
      />
      <img
        src="/img/flor.webp"
        alt="Flor"
        class="absolute -bottom-10 -left-10 w-32 rotate-15 md:hidden animate-sway-delayed pointer-events-none z-20 scroll-reveal delay-500 opacity-80 drop-shadow-[0_5px_10px_rgba(0,0,0,0.5)]"
      />

      {/* 🟢 CONTENIDO DE TEXTO */}
      <div class="relative z-30 w-full flex flex-col items-center">
        {/* PADRES */}
        <div class="scroll-reveal flex flex-col items-center w-full">
          <h3
            class="font-script text-4xl md:text-6xl text-[#D4AF37] mb-2 drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)]"
          >
            <span class="es-content">Mis Padres</span>
            <span class="en-content">My Parents</span>
          </h3>
          <p
            class="font-elegante text-2xl md:text-3xl text-slate-50 font-medium tracking-widest mt-4 drop-shadow-sm"
          >
            Carlos Ruiz
          </p>
          <p
            class="font-elegante text-lg md:text-xl text-[#c1b07a] italic my-1 opacity-80"
          >
            &
          </p>
          <p
            class="font-elegante text-2xl md:text-3xl text-slate-50 font-medium tracking-widest drop-shadow-sm"
          >
            Graciana Castellanos
          </p>
        </div>

        {/* SEPARADOR SVG DORADO */}
        <div class="w-full flex justify-center my-10 scroll-reveal delay-200">
          <svg
            width="80"
            height="15"
            viewBox="0 0 60 15"
            fill="none"
            stroke="#D4AF37"
            stroke-width="1.5"
            class="opacity-80 drop-shadow-[0_0_5px_rgba(212,175,55,0.3)]"
          >
            <path
              d="M30 2L35 7.5L30 13L25 7.5Z"
              fill="#D4AF37"
              fill-opacity="0.4"></path>
            <line x1="0" y1="7.5" x2="20" y2="7.5"></line>
            <line x1="40" y1="7.5" x2="60" y2="7.5"></line>
          </svg>
        </div>

        {/* PADRINOS */}
        <div class="scroll-reveal flex flex-col items-center w-full">
          <h3
            class="font-script text-4xl md:text-6xl text-[#D4AF37] mb-2 drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)]"
          >
            <span class="es-content">Mis Padrinos</span>
            <span class="en-content">My Godparents</span>
          </h3>
          <p
            class="font-elegante text-2xl md:text-3xl text-slate-50 font-medium tracking-widest mt-4 drop-shadow-sm"
          >
            Mario Baez
          </p>
          <p
            class="font-elegante text-lg md:text-xl text-[#c1b07a] italic my-1 opacity-80"
          >
            &
          </p>
          <p
            class="font-elegante text-2xl md:text-3xl text-slate-50 font-medium tracking-widest drop-shadow-sm"
          >
            Jessica Baez-Restrepo
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* 🟢 ANIMACIÓN DE REVELADO */
  .scroll-reveal {
    opacity: 0;
    transform: translateY(30px);
    transition: all 1s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .scroll-reveal.active {
    opacity: 1;
    transform: translateY(0);
  }

  /* Delays */
  .delay-200 {
    transition-delay: 0.2s;
  }
  .delay-300 {
    transition-delay: 0.3s;
  }
  .delay-400 {
    transition-delay: 0.4s;
  }
  .delay-500 {
    transition-delay: 0.5s;
  }
  .delay-600 {
    transition-delay: 0.6s;
  }

  /* 🟢 BALANCEO */
  .animate-sway {
    animation: sway 8s ease-in-out infinite;
  }
  .animate-sway-delayed {
    animation: sway 9s ease-in-out 3s infinite reverse;
  }

  @keyframes sway {
    0%,
    100% {
      transform: translateY(0) rotate(var(--tw-rotate, 0deg));
    }
    50% {
      transform: translateY(-12px) rotate(calc(var(--tw-rotate, 0deg) + 6deg));
    }
  }
</style>

<script>
  function initPadresReveal() {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("active");
          }
        });
      },
      { threshold: 0.15, rootMargin: "0px 0px -50px 0px" },
    );

    document
      .querySelectorAll(".scroll-reveal")
      .forEach((el) => observer.observe(el));
  }
  document.addEventListener("DOMContentLoaded", initPadresReveal);
</script>
