---
// src/components/Cronometro.astro

// 🟢 FECHA DEL EVENTO: Año, Mes (0-11, pero en string es normal), Día, Hora
const eventDate = "2026-08-14T19:00:00";
---

<section
  class="relative z-15 h-100 w-screen overflow-x-clip py-28 flex flex-col items-center justify-center bg-neutral-50 rounded-t-[30px] md:rounded-t-[50px]"
>
  {/* 🟢 FLOR SUPERIOR IZQUIERDA (Minimalista) */}
  <div
    class="absolute -left-10 md:-left-16 -top-5 md:-top-16 z-0 opacity-40 scroll-animate delay-500 pointer-events-none"
  >
    <img
      src="/img/flor2.webp"
      alt="Flor Decorativa"
      class="w-40 md:w-56 transform rotate-135 animate-float"
    />
  </div>

  {/* 🟢 FLOR INFERIOR DERECHA (Minimalista) */}
  <div
    class="absolute -right-10 md:-right-16 -bottom-10 md:-bottom-16 z-0 opacity-40 scroll-animate delay-700 pointer-events-none"
  >
    <img
      src="/img/flor2.webp"
      alt="Flor Decorativa"
      class="w-40 md:w-56 transform -rotate-45 animate-float-delayed"
    />
  </div>

  {/* Título de la sección */}
  <div class="relative z-10 text-center mb-12 scroll-animate delay-100">
    <h3
      class="font-elegante italic text-4xl md:text-5xl text-slate-600 font-bold drop-shadow-sm"
    >
      Falta muy poco...
    </h3>
  </div>

  {/* CONTENEDOR DE LA CUENTA REGRESIVA */}
  <div
    class="relative z-10 flex gap-4 md:gap-8 items-center justify-center scroll-animate delay-300"
  >
    {/* DÍAS */}
    <div class="flex flex-col items-center">
      <div
        class="w-16 h-16 md:w-24 md:h-24 bg-[#223555] border border-[#D4AF37]/30 rounded-2xl flex items-center justify-center shadow-lg shadow-[#223555]/20"
      >
        <span id="days" class="font-script text-4xl md:text-6xl text-[#D4AF37]"
          >00</span
        >
      </div>
      <span
        class="font-limpia text-[#D4AF37] text-[10px] md:text-sm tracking-[0.2em] uppercase mt-3 font-semibold drop-shadow-sm"
        >Días</span
      >
    </div>

    <span class="text-slate-300 text-2xl md:text-4xl pb-6 font-thin"> : </span>

    {/* HORAS */}
    <div class="flex flex-col items-center">
      <div
        class="w-16 h-16 md:w-24 md:h-24 bg-[#223555] border border-[#D4AF37]/30 rounded-2xl flex items-center justify-center shadow-lg shadow-[#223555]/20"
      >
        <span id="hours" class="font-script text-4xl md:text-6xl text-[#D4AF37]"
          >00</span
        >
      </div>
      <span
        class="font-limpia text-[#D4AF37] text-[10px] md:text-sm tracking-[0.2em] uppercase mt-3 font-semibold drop-shadow-sm"
        >Hrs</span
      >
    </div>

    <span class="text-slate-300 text-2xl md:text-4xl pb-6 font-thin"> : </span>

    {/* MINUTOS */}
    <div class="flex flex-col items-center">
      <div
        class="w-16 h-16 md:w-24 md:h-24 bg-[#223555] border border-[#D4AF37]/30 rounded-2xl flex items-center justify-center shadow-lg shadow-[#223555]/20"
      >
        <span
          id="minutes"
          class="font-script text-4xl md:text-6xl text-[#D4AF37]">00</span
        >
      </div>
      <span
        class="font-limpia text-[#D4AF37] text-[10px] md:text-sm tracking-[0.2em] uppercase mt-3 font-semibold drop-shadow-sm"
        >Min</span
      >
    </div>

    {/* SEGUNDOS */}
    <div class="flex flex-col items-center ml-2">
      <div
        class="w-16 h-16 md:w-24 md:h-24 bg-[#223555] border border-[#D4AF37]/60 rounded-2xl flex items-center justify-center shadow-lg shadow-[#223555]/20"
      >
        <span
          id="seconds"
          class="font-script text-4xl md:text-6xl text-[#D4AF37]">00</span
        >
      </div>
      <span
        class="font-limpia text-[#D4AF37] text-[10px] md:text-sm tracking-[0.2em] uppercase mt-3 font-bold drop-shadow-sm"
        >Seg</span
      >
    </div>
  </div>
</section>

<style>
  /* 🟢 CLASES PARA LA ANIMACIÓN AL HACER SCROLL */
  .scroll-animate {
    opacity: 0;
    transform: translateY(30px);
    transition:
      opacity 1s ease-out,
      transform 1s ease-out;
  }

  .scroll-animate.delay-100 {
    transition-delay: 0.1s;
  }
  .scroll-animate.delay-300 {
    transition-delay: 0.3s;
  }
  .scroll-animate.delay-500 {
    transition-delay: 0.5s;
  }
  .scroll-animate.delay-700 {
    transition-delay: 0.7s;
  }

  .scroll-animate.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* 🟢 ANIMACIÓN FLOTANTE */
  .animate-float {
    animation: float 8s ease-in-out infinite;
  }

  .animate-float-delayed {
    animation: float 8s ease-in-out 4s infinite;
  }

  @keyframes float {
    0% {
      transform: translateY(0px) rotate(var(--tw-rotate));
    }
    50% {
      transform: translateY(-8px) rotate(calc(var(--tw-rotate) + 3deg));
    }
    100% {
      transform: translateY(0px) rotate(var(--tw-rotate));
    }
  }
</style>

<script define:vars={{ eventDate }}>
  const updateTimer = () => {
    const now = new Date().getTime();
    const target = new Date(eventDate).getTime();
    const difference = target - now;

    if (difference < 0) {
      document.getElementById("days").innerText = "00";
      document.getElementById("hours").innerText = "00";
      document.getElementById("minutes").innerText = "00";
      document.getElementById("seconds").innerText = "00";
      return;
    }

    const days = Math.floor(difference / (1000 * 60 * 60 * 24));
    const hours = Math.floor(
      (difference % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60),
    );
    const minutes = Math.floor((difference % (1000 * 60 * 60)) / (1000 * 60));
    const seconds = Math.floor((difference % (1000 * 60)) / 1000);

    document.getElementById("days").innerText = days
      .toString()
      .padStart(2, "0");
    document.getElementById("hours").innerText = hours
      .toString()
      .padStart(2, "0");
    document.getElementById("minutes").innerText = minutes
      .toString()
      .padStart(2, "0");
    document.getElementById("seconds").innerText = seconds
      .toString()
      .padStart(2, "0");
  };

  updateTimer();
  setInterval(updateTimer, 1000);

  document.addEventListener("DOMContentLoaded", () => {
    const observerOptions = {
      root: null,
      rootMargin: "0px",
      threshold: 0.2,
    };

    const observer = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    const animatedElements = document.querySelectorAll(".scroll-animate");
    animatedElements.forEach((el) => observer.observe(el));
  });
</script>
