---
// src/components/Contactos.astro
---

<section
  class="relative w-full py-16 flex justify-center items-center bg-slate-50 overflow-hidden px-4 md:px-8"
>
  {/* 🟢 CONTENEDOR PRINCIPAL */}
  {
    /* En desktop: Este contenedor lleva el borde dorado continuo y la sombra para que parezca 1 sola tarjeta */
  }
  <div
    class="relative z-10 w-full max-w-6xl mx-auto flex flex-col md:flex-row gap-16 md:gap-0
    md:border md:border-[#D4AF37] md:rounded-[2.5rem] md:shadow-[0_20px_50px_rgba(0,0,0,0.4)]
    transition-all duration-700 md:hover:shadow-[0_0_40px_rgba(212,175,55,0.25)]"
  >
    {/* 🟢 COLUMNA DE LA IMAGEN (Izquierda en desktop) */}
    {/* En desktop pierde el borde para usar el del padre */}
    <div
      class="relative w-full md:w-1/2 min-h-125 md:min-h-0 h-[55dvh] md:h-auto z-20 scroll-reveal
      border border-[#D4AF37] rounded-3xl md:border-none md:rounded-none"
    >
      {
        /* ENVOLTURA DE LA IMAGEN (Aquí va el overflow-hidden para que NO corte la flor) */
      }
      <div
        class="absolute inset-0 overflow-hidden rounded-3xl md:rounded-none md:rounded-l-[2.5rem] shadow-[0_15px_30px_rgba(0,0,0,0.5)] md:shadow-none"
      >
        <img
          src="/img/4.webp"
          alt="Maya Quinceañera"
          class="w-full h-full object-cover transition-transform duration-1000 hover:scale-105"
        />
        {/* Sombra interna para fusionar */}
        <div
          class="absolute inset-0 shadow-[inset_0_-40px_40px_-20px_rgba(2,6,23,0.8)] md:shadow-[inset_-30px_0_40px_-30px_rgba(2,6,23,0.9)] pointer-events-none"
        >
        </div>
      </div>

      {/* 🌸 FLOR IZQUIERDA (Ahora fuera de la envoltura, puede sobresalir) */}
      <img
        src="/img/rosa2.webp"
        alt="Flor Decorativa"
        class="absolute -bottom-12 -left-8 w-36 max-md:hidden md:w-56 -rotate-45 animate-sway-delayed pointer-events-none z-30 scroll-reveal delay-500 opacity-90 drop-shadow-[0_10px_15px_rgba(0,0,0,0.6)]"
      />
    </div>

    {/* 🟢 COLUMNA DE TEXTO / CONTACTOS (Derecha en desktop) */}
    {/* En desktop pierde el borde para usar el del padre */}
    <div
      class="relative w-full md:w-1/2 min-h-150 px-6 py-16 md:min-h-200 md:p-12 lg:p-16 flex flex-col justify-center items-center text-center z-10
      border border-[#D4AF37] rounded-3xl md:border-none md:rounded-none"
    >
      {/* Fondo de la Hoja (Azul noche translúcido) */}
      <div
        class="absolute inset-0 bg-[#0a111e]/50 backdrop-blur-xl rounded-3xl md:rounded-none md:rounded-r-[2.5rem] overflow-hidden z-0 md:shadow-[inset_20px_0_40px_-20px_rgba(2,6,23,0.9)]"
      >
        <div
          class="absolute inset-0 bg-[url('/img/hoja.webp')] bg-repeat bg-cover bg-center mix-blend-overlay"
        >
        </div>
      </div>

      {/* 🌸 FLOR DERECHA (Arriba en escritorio, animada) */}
      <img
        src="/img/rosa2.webp"
        alt="Flor"
        class="absolute -top-12 -right-8 w-36 md:w-52 rotate-135 animate-sway pointer-events-none z-30 scroll-reveal delay-300 opacity-90 drop-shadow-[0_10px_15px_rgba(0,0,0,0.6)]"
      />
      {/* 🌸 FLOR EXTRA (Solo visible en móvil para balancear) */}
      <img
        src="/img/rosa2.webp"
        alt="Flor"
        class="absolute -bottom-10 -left-10 w-32 md:hidden -rotate-45 animate-sway-delayed pointer-events-none z-20 scroll-reveal delay-500 opacity-80 drop-shadow-[0_5px_10px_rgba(0,0,0,0.5)]"
      />

      <div class="relative z-30 w-full flex flex-col items-center">
        {/* TÍTULO */}
        <div class="scroll-reveal flex flex-col items-center w-full">
          <h3
            class="font-script text-5xl md:text-7xl text-[#D4AF37] mb-2 drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)]"
          >
            Contactos
          </h3>
          <p
            class="font-limpia text-slate-200 text-[10px] md:text-xs tracking-[0.4em] md:tracking-[0.5em] uppercase mb-10 md:mb-14 opacity-90 pr-[0.4em]"
          >
            Confirmar asistencia:
          </p>
        </div>

        {/* 📱 CONTENEDOR DE BOTONES */}
        <div class="flex flex-col gap-5 w-full max-w-md justify-center">
          {/* BOTÓN 1: YAYI */}
          <a
            href="https://wa.me/17183449837"
            target="_blank"
            class="scroll-reveal delay-200 group w-full flex items-center justify-between bg-white/5 border border-white/10 p-4 md:p-5 rounded-2xl transition-all duration-500 hover:bg-[#D4AF37]/15 hover:border-[#D4AF37] hover:shadow-[0_0_20px_rgba(212,175,55,0.2)] hover:-translate-y-1 relative overflow-hidden"
          >
            <div
              class="absolute inset-0 bg-linear-to-r from-transparent via-white/5 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-1000"
            >
            </div>

            <div class="flex flex-col items-start relative z-10">
              <span
                class="font-elegante text-[#c1b07a] text-xl md:text-2xl tracking-widest font-bold drop-shadow-sm group-hover:text-white transition-colors duration-300"
              >
                Yayi
              </span>
              <span
                class="font-elegante text-slate-100 text-sm md:text-base tracking-wider mt-1 opacity-80 group-hover:opacity-100 transition-opacity"
              >
                (718) 344-9837
              </span>
            </div>

            <div
              class="relative z-10 bg-linear-to-br from-[#162642] to-[#0a111e] border border-[#D4AF37]/40 p-3 md:p-4 rounded-full transition-all duration-500 group-hover:bg-[#D4AF37] group-hover:border-[#D4AF37] group-hover:scale-110 shadow-[0_0_15px_rgba(0,0,0,0.5)] group-hover:shadow-[0_0_15px_rgba(212,175,55,0.6)]"
            >
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                class="text-[#c1b07a] group-hover:text-[#0a111e] transition-colors duration-300"
              >
                <path
                  d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"
                ></path>
              </svg>
            </div>
          </a>

          {/* BOTÓN 2: CARLOS */}
          <a
            href="https://wa.me/17187574075"
            target="_blank"
            class="scroll-reveal delay-400 group w-full flex items-center justify-between bg-white/5 border border-white/10 p-4 md:p-5 rounded-2xl transition-all duration-500 hover:bg-[#D4AF37]/15 hover:border-[#D4AF37] hover:shadow-[0_0_20px_rgba(212,175,55,0.2)] hover:-translate-y-1 relative overflow-hidden"
          >
            <div
              class="absolute inset-0 bg-linear-to-r from-transparent via-white/5 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-1000"
            >
            </div>

            <div class="flex flex-col items-start relative z-10">
              <span
                class="font-elegante text-[#c1b07a] text-xl md:text-2xl tracking-widest font-bold drop-shadow-sm group-hover:text-white transition-colors duration-300"
              >
                Carlos
              </span>
              <span
                class="font-elegante text-slate-100 text-sm md:text-base tracking-wider mt-1 opacity-80 group-hover:opacity-100 transition-opacity"
              >
                (718) 757-4075
              </span>
            </div>

            <div
              class="relative z-10 bg-linear-to-br from-[#162642] to-[#0a111e] border border-[#D4AF37]/40 p-3 md:p-4 rounded-full transition-all duration-500 group-hover:bg-[#D4AF37] group-hover:border-[#D4AF37] group-hover:scale-110 shadow-[0_0_15px_rgba(0,0,0,0.5)] group-hover:shadow-[0_0_15px_rgba(212,175,55,0.6)]"
            >
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                class="text-[#c1b07a] group-hover:text-[#0a111e] transition-colors duration-300"
              >
                <path
                  d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"
                ></path>
              </svg>
            </div>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* 🟢 ANIMACIÓN DE REVELADO */
  .scroll-reveal {
    opacity: 0;
    transform: translateY(30px);
    transition: all 1s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .scroll-reveal.active {
    opacity: 1;
    transform: translateY(0);
  }

  /* Delays */
  .delay-200 {
    transition-delay: 0.2s;
  }
  .delay-300 {
    transition-delay: 0.3s;
  }
  .delay-400 {
    transition-delay: 0.4s;
  }
  .delay-500 {
    transition-delay: 0.5s;
  }

  /* 🟢 BALANCEO */
  .animate-sway {
    animation: sway 8s ease-in-out infinite;
  }
  .animate-sway-delayed {
    animation: sway 9s ease-in-out 3s infinite reverse;
  }

  @keyframes sway {
    0%,
    100% {
      transform: translateY(0) rotate(var(--tw-rotate, 0deg));
    }
    50% {
      transform: translateY(-12px) rotate(calc(var(--tw-rotate, 0deg) + 6deg));
    }
  }
</style>

<script>
  function initContactReveal() {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("active");
          }
        });
      },
      { threshold: 0.15, rootMargin: "0px 0px -50px 0px" },
    );

    document
      .querySelectorAll(".scroll-reveal")
      .forEach((el) => observer.observe(el));
  }
  document.addEventListener("DOMContentLoaded", initContactReveal);
</script>
