---
// src/components/BabyGallery.astro

const childhoodPhotos = [
  { src: "/img/BABYPICT/b3.webp", alt: "Maya de bebé", rotate: "-rotate-3" },
  { src: "/img/BABYPICT/b5.webp", alt: "Primeros pasos", rotate: "rotate-2" },
  { src: "/img/BABYPICT/b1.webp", alt: "Maya jugando", rotate: "-rotate-2" },
  { src: "/img/BABYPICT/b4.webp", alt: "Cumpleaños 5", rotate: "rotate-3" },
  {
    src: "/img/BABYPICT/b2.webp",
    alt: "Maya en el parque",
    rotate: "-rotate-1",
  },
  {
    src: "/img/BABYPICT/b6.webp",
    alt: "Recuerdos felices",
    rotate: "rotate-6",
  },
];
---

<section class="relative w-full py-24 bg-white overflow-hidden px-4 md:px-8">
  {/* 🟢 DECORACIÓN DE FONDO (Hojas y Flores) */}
  <div
    class="absolute inset-0 bg-[url('/img/hoja.webp')] bg-repeat opacity-[0.05] pointer-events-none"
  >
  </div>

  {/* Título de la Sección */}
  <div class="relative z-10 text-center mb-16 gallery-reveal">
    <h3
      class="font-script text-5xl md:text-7xl text-[#D4AF37] mb-2 drop-shadow-sm"
    >
      Mis Primeros Pasos
    </h3>
    <p
      class="font-limpia text-gray-500 text-xs md:text-sm tracking-[0.3em] uppercase opacity-70"
    >
      Un pequeño viaje por mis recuerdos
    </p>
  </div>

  {/* 🟢 GRID DE GALERÍA */}
  <div
    class="relative z-10 max-w-6xl mx-auto grid grid-cols-2 md:grid-cols-3 gap-6 md:gap-10"
  >
    {
      childhoodPhotos.map((photo, index) => (
        <div
          class={`relative group gallery-item ${photo.rotate} scroll-reveal`}
          style={`transition-delay: ${index * 150}ms;`}
        >
          {/* Marco de la Foto */}
          <div class="bg-white p-2 md:p-4 shadow-[0_10px_30px_rgba(0,0,0,0.1)] border border-gray-100 rounded-sm transform transition-all duration-500 group-hover:rotate-0 group-hover:scale-110 group-hover:z-50 group-hover:shadow-2xl cursor-pointer">
            <div class="overflow-hidden aspect-4/5 bg-gray-100">
              <img
                src={photo.src}
                alt={photo.alt}
                class="w-full h-full object-cover grayscale-30 group-hover:grayscale-0 transition-all duration-700"
              />
            </div>
            {/* Pie de foto sutil */}
            <p class="font-elegante text-[10px] md:text-xs text-gray-400 mt-3 italic text-center uppercase tracking-widest">
              Memory #{index + 1}
            </p>
          </div>

          {/* Flores decorativas pegadas a algunas fotos */}
          {index % 2 === 0 && (
            <img
              src="/img/rosa.webp"
              alt=""
              class="absolute -top-4 -right-4 w-10 md:w-16 z-20 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none animate-sway"
            />
          )}
        </div>
      ))
    }
  </div>

  {/* 🟢 FLORES FLOTANTES EXTRAS POR LA SECCIÓN */}
  <img
    src="/img/lirio.webp"
    alt=""
    class="absolute top-[15%] left-[-5%] w-32 md:w-56 opacity-20 -rotate-45 pointer-events-none"
  />
  <img
    src="/img/rosa.webp"
    alt=""
    class="absolute bottom-[10%] right-[-2%] w-24 md:w-48 opacity-30 rotate-12 pointer-events-none"
  />
  <img
    src="/img/lirio.webp"
    alt=""
    class="absolute top-[50%] right-[2%] w-16 md:w-32 opacity-15 rotate-90 pointer-events-none"
  />
</section>

<style>
  /* 🟢 ANIMACIONES DE REVELACIÓN */
  .scroll-reveal {
    opacity: 0;
    transform: translateY(30px) scale(0.9);
    transition: all 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .scroll-reveal.active {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .gallery-reveal {
    opacity: 0;
    transform: translateY(-20px);
    transition: all 1s ease-out;
  }

  .gallery-reveal.active {
    opacity: 1;
    transform: translateY(0);
  }

  /* Balanceo de las rosas pequeñas */
  .animate-sway {
    animation: sway 4s ease-in-out infinite alternate;
  }

  @keyframes sway {
    from {
      transform: rotate(-10deg) translateY(0);
    }
    to {
      transform: rotate(10deg) translateY(-5px);
    }
  }
</style>

<script>
  function initGallery() {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("active");
            // Si es un contenedor, animamos los hijos también
            const children = entry.target.querySelectorAll(".scroll-reveal");
            children.forEach((child) => child.classList.add("active"));
          }
        });
      },
      { threshold: 0.15 },
    );

    // Observamos el título y los items de la galería
    document
      .querySelectorAll(".gallery-reveal, .scroll-reveal")
      .forEach((el) => observer.observe(el));
  }

  document.addEventListener("DOMContentLoaded", initGallery);
</script>
