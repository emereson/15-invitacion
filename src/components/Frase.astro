---
// src/components/Frase.astro
---

<section
  class="relative z-9 w-full overflow-visible bg-[#162642] py-12 md:py-16 border-y border-[#D4AF37]/30 frase-section shadow-[inset_0_0_15px_rgba(212,175,55,0.1)]"
>
  {/* 🟢 CAPA DE BRILLOS (Pequeños y sutiles) */}
  <div
    class="absolute top-0 left-0 w-full h-full opacity-0 bg-[url('/img/brillos.gif')] bg-size-[200px_200px] bg-repeat z-10 pointer-events-none mix-blend-screen brillos-layer"
  >
  </div>

  {/* 🟢 FLOR DECORATIVA INFERIOR IZQUIERDA (Opacidad al 100%) */}
  <div
    class="absolute z-20 -left-5 md:-left-10 -bottom-5 md:-bottom-10 opacity-0 transform animate-float flor-decorativa pointer-events-none"
  >
    <img
      src="/img/flor.webp"
      alt="Flor Decorativa"
      class="w-30 md:w-40 transform"
    />
  </div>

  <div class="relative z-20 max-w-4xl mx-auto px-6 text-center reveal-content">
    {/* Ícono decorativo superior */}
    <div class="mb-6 flex justify-center opacity-50">
      <svg width="40" height="16" viewBox="0 0 40 20" fill="none">
        <path
          d="M0 10C10 10 15 0 20 0C25 0 30 10 40 10"
          stroke="#D4AF37"
          stroke-width="1"></path>
      </svg>
    </div>

    <p
      class="font-elegante text-lg md:text-xl lg:text-2xl text-white/90 leading-relaxed tracking-wide italic"
    >
      "Hay momentos en la vida que son <span
        class="text-[#D4AF37] font-bold not-italic">especiales</span
      > por sí solos. Compartirlos con personas que aprecias y amas los convierte
      en algo
      <span class="text-[#D4AF37] font-bold not-italic"
        >mágico e inolvidable</span
      >. Gracias por estar aquí."
    </p>

    {/* Ícono decorativo inferior */}
    <div class="mt-6 flex justify-center opacity-50 rotate-180">
      <svg width="40" height="16" viewBox="0 0 40 20" fill="none">
        <path
          d="M0 10C10 10 15 0 20 0C25 0 30 10 40 10"
          stroke="#D4AF37"
          stroke-width="1"></path>
      </svg>
    </div>
  </div>
</section>

<style>
  /* 🟢 ANIMACIÓN DE SCROLL */
  .frase-section {
    opacity: 0;
    transform: scale(0.98);
    transition:
      opacity 1.2s ease-out,
      transform 1.2s ease-out;
  }

  .frase-section.active {
    opacity: 1;
    transform: scale(1);
  }

  .reveal-content {
    opacity: 0;
    transition: opacity 1s ease-out 0.4s;
  }

  .frase-section.active .reveal-content {
    opacity: 1;
  }

  .brillos-layer {
    transition: opacity 2s ease-in 0.8s;
  }

  .frase-section.active .brillos-layer {
    opacity: 0.3;
  }

  /* 🟢 FLOR CON OPACIDAD TOTAL AL REVELARSE */
  .flor-decorativa {
    transition: opacity 1.5s ease-out 0.6s;
  }

  .frase-section.active .flor-decorativa {
    opacity: 0.6; /* Flor ahora visible al 100% */
  }

  .animate-float {
    animation: float 8s ease-in-out infinite;
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0) rotate(-15deg);
    }
    50% {
      transform: translateY(-10px) rotate(-12deg);
    }
  }
</style>

<script>
  const initFraseReveal = () => {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("active");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.3 },
    );

    const section = document.querySelector(".frase-section");
    if (section) observer.observe(section);
  };

  document.addEventListener("DOMContentLoaded", initFraseReveal);
</script>
