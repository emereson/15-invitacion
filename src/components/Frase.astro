---
// src/components/Frase.astro
---

<section
  class="relative z-10 w-full overflow-visible bg-[#0a111e] py-16 md:py-20 border-y border-[#D4AF37]/30 frase-section"
>
  {/* 🟢 CAPA DE BRILLOS (Ajustada para que parezcan estrellas lejanas) */}
  <div
    class="absolute top-0 left-0 w-full h-full opacity-0 bg-[url('/img/brillos.gif')] bg-size-[250px_250px] bg-repeat z-10 pointer-events-none mix-blend-screen brillos-layer"
  >
  </div>

  {/* 🟢 FLOR DECORATIVA */}
  <div
    class="absolute z-30 -left-6 md:-left-12 -bottom-8 md:-bottom-12 opacity-0 transform animate-float flor-decorativa pointer-events-none"
  >
    <img
      src="/img/flor.webp"
      alt="Flor Decorativa"
      class="w-32 md:w-48 transform drop-shadow-[0_0_15px_rgba(59,130,246,0.5)]"
    />
  </div>

  <div class="relative z-20 max-w-4xl mx-auto px-6 text-center reveal-content">
    {/* Ícono decorativo superior */}
    <div class="mb-8 flex justify-center opacity-60">
      <svg width="50" height="20" viewBox="0 0 40 20" fill="none">
        <path
          d="M0 10C10 10 15 0 20 0C25 0 30 10 40 10"
          stroke="#D4AF37"
          stroke-width="1.5"></path>
      </svg>
    </div>

    <p
      class="font-elegante text-lg md:text-2xl lg:text-3xl text-white leading-relaxed tracking-wide italic frase-text"
    >
      <span class="es-content">
        "Hay momentos en la vida que son <span
          class="text-[#D4AF37] font-bold not-italic">especiales</span
        > por sí solos. Compartirlos con personas que aprecias y amas los convierte
        en algo
        <span class="text-[#D4AF37] font-bold not-italic"
          >mágico e inolvidable</span
        >. Gracias por estar aquí."
      </span>
      <span class="en-content">
        "There are moments in life that are <span
          class="text-[#D4AF37] font-bold not-italic">special</span
        > on their own. Sharing them with people you appreciate and love makes them
        <span class="text-[#D4AF37] font-bold not-italic"
          >magical and unforgettable</span
        >. Thank you for being here."
      </span>
    </p>

    {/* Ícono decorativo inferior */}
    <div class="mt-8 flex justify-center opacity-60 rotate-180">
      <svg width="50" height="20" viewBox="0 0 40 20" fill="none">
        <path
          d="M0 10C10 10 15 0 20 0C25 0 30 10 40 10"
          stroke="#D4AF37"
          stroke-width="1.5"></path>
      </svg>
    </div>
  </div>
</section>

<style>
  /* 🔵 EFECTO NOCHE ESTRELLADA (Sombra Externa Azul) */
  .frase-section {
    opacity: 0;
    transform: scale(0.98);
    /* Sombras externas: una profunda y otra más brillante para el glow */
    box-shadow:
      0 0 60px -10px rgba(10, 25, 47, 0.9),
      0 0 40px rgba(59, 130, 246, 0.25),
      inset 0 0 20px rgba(212, 175, 55, 0.05); /* Sutil dorado interno */
    transition:
      opacity 1.5s ease-out,
      transform 1.2s ease-out,
      box-shadow 2s ease-in-out;
  }

  .frase-section.active {
    opacity: 1;
    transform: scale(1);
    /* El resplandor se intensifica al activarse */
    box-shadow:
      0 0 130px -10px rgba(10, 25, 47, 1),
      0 0 60px rgba(59, 130, 246, 0.4),
      inset 0 0 30px rgba(212, 175, 55, 0.1);
  }

  /* 🔵 GLOW EN EL TEXTO */
  .frase-text {
    text-shadow:
      0 0 10px rgba(0, 0, 0, 0.8),
      0 0 25px rgba(59, 130, 246, 0.5);
  }

  /* --- RESTO DE ANIMACIONES --- */
  .reveal-content {
    opacity: 0;
    transition: opacity 1s ease-out 0.5s;
  }

  .frase-section.active .reveal-content {
    opacity: 1;
  }

  .brillos-layer {
    transition: opacity 2.5s ease-in 1s;
  }

  .frase-section.active .brillos-layer {
    opacity: 0.4;
  }

  .flor-decorativa {
    transition:
      opacity 1.8s ease-out 0.8s,
      transform 1.5s ease-out 0.8s;
  }

  .frase-section.active .flor-decorativa {
    opacity: 0.8;
  }

  .animate-float {
    animation: float 10s ease-in-out infinite;
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0) rotate(-15deg);
    }
    50% {
      transform: translateY(-15px) rotate(-10deg);
    }
  }
</style>

<script>
  const initFraseReveal = () => {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("active");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.2 },
    );

    const section = document.querySelector(".frase-section");
    if (section) observer.observe(section);
  };

  document.addEventListener("DOMContentLoaded", initFraseReveal);
</script>
