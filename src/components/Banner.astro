---
// src/components/Banner.astro
---

<section
  class="sticky top-0 w-full h-dvh flex flex-col items-center justify-center overflow-hidden bg-black"
>
  {/* 🟢 1. LA FOTO DE MAYA (Fondo de Pantalla Completa) */}
  <img
    src="/img/Principal.jpg"
    alt="Maya"
    class="absolute inset-0 w-full h-full object-cover object-[left_30%] opacity-0 animate-fade-in-slow z-0"
  />
  <div
    class="absolute inset-0 bg-black/20 bg-linear-to-t from-black/80 via-black/20 to-transparent z-10 pointer-events-none"
  >
  </div>

  <div
    class="absolute top-0 left-0 w-full h-full opacity-30 bg-[url('/img/brillos.gif')] bg-repeat bg-auto bg-center z-20 pointer-events-none mix-blend-screen"
  >
  </div>

  {/* 🟢 4. MARIPOSAS ALEATORIAS QUE RECORREN TODA LA PANTALLA */}
  <div class="absolute inset-0 z-30 pointer-events-none overflow-hidden">
    <img
      src="/img/mariposa.gif"
      alt="Mariposa"
      class="w-6 md:w-8 absolute opacity-90 animate-wander-1"
    />
    <img
      src="/img/mariposa.gif"
      alt="Mariposa"
      class="w-4 md:w-6 absolute opacity-70 animate-wander-2"
    />
    <img
      src="/img/mariposa.gif"
      alt="Mariposa"
      class="w-8 md:w-10 absolute opacity-90 animate-wander-3"
    />
    <img
      src="/img/mariposa.gif"
      alt="Mariposa"
      class="w-5 md:w-7 absolute opacity-80 animate-wander-4"
    />
    <img
      src="/img/mariposa.gif"
      alt="Mariposa"
      class="w-6 md:w-9 absolute opacity-90 animate-wander-1 delay-2000"
    />
    <img
      src="/img/mariposa.gif"
      alt="Mariposa"
      class="w-4 md:w-5 absolute opacity-70 animate-wander-2 delay-3500"
    />
  </div>

  {
    /* 🟢 5. TEXTO CENTRALIZADO Y EMPUJADO HACIA ABAJO (Para no tapar el rostro en la foto) */
  }
  <div
    class="relative z-40 flex flex-col items-center justify-end w-full h-full pb-32 md:pb-40 text-center pointer-events-none"
  >
    <h1
      class="font-script text-6xl md:text-[7rem] text-white drop-shadow-[0_4px_10px_rgba(0,0,0,0.9)] leading-none animate-fade-in-up delay-1700 py-1"
    >
      Mis 15 Años
    </h1>

    <h2
      class="font-elegante italic text-4xl md:text-5xl text-white font-bold mt-1 tracking-wide animate-fade-in-up delay-1900 drop-shadow-[0_4px_10px_rgba(0,0,0,0.9)]"
    >
      Maya
    </h2>

    <div
      class="mt-2 md:mt-4 animate-fade-in-up delay-2100 text-gray-300 drop-shadow-lg"
    >
      <svg
        width="20"
        height="8"
        viewBox="0 0 60 15"
        fill="currentColor"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path d="M25 7.5L30 2L35 7.5L30 13L25 7.5Z"></path>
        <line
          x1="0"
          y1="7.5"
          x2="20"
          y2="7.5"
          stroke="currentColor"
          stroke-width="2"></line>
        <line
          x1="40"
          y1="7.5"
          x2="60"
          y2="7.5"
          stroke="currentColor"
          stroke-width="2"></line>
      </svg>
    </div>

    <div
      class="font-limpia mt-4 px-6 py-2 border-y border-gray-400/50 text-gray-100 text-sm md:text-lg tracking-[0.4em] font-medium animate-fade-in-up delay-2100 shadow-sm drop-shadow-lg bg-black/40 backdrop-blur-md rounded-full pointer-events-auto"
    >
      14 . 08 . 2026
    </div>
  </div>

  {/* 🟢 6. FLECHA DE SCROLL */}
  <div
    class="absolute bottom-6 md:bottom-10 z-50 flex flex-col items-center opacity-80 animate-fade-in-up delay-2500"
  >
    <span
      class="font-limpia text-gray-300 text-[9px] md:text-xs tracking-widest uppercase mb-1 animate-pulse"
    >
      Desliza
    </span>
    <div class="animate-bounce text-white">
      <svg
        class="w-5 h-5 md:w-6 md:h-6 drop-shadow-[0_0_8px_rgba(255,255,255,0.6)]"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
      </svg>
    </div>
  </div>
</section>

<style>
  /* --- TEXTOS E IMAGEN CENTRAL --- */
  .animate-fade-in-slow {
    opacity: 0;
    animation: fadeInSlow 2s ease-in-out 0.5s forwards;
  }
  @keyframes fadeInSlow {
    0% {
      opacity: 0;
      transform: scale(
        1.05
      ); /* Pequeño zoom out inicial para darle un toque más elegante */
    }
    100% {
      opacity: 1; /* Ahora sube a 1 de opacidad porque es el fondo principal */
      transform: scale(1);
    }
  }

  .animate-fade-in-up {
    opacity: 0;
    animation: fadeInUp 1s ease-out forwards;
  }
  @keyframes fadeInUp {
    0% {
      opacity: 0;
      transform: translateY(20px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* 🟢 MARIPOSAS ALEATORIAS POR TODA LA PANTALLA */
  .animate-wander-1 {
    animation: wander1 25s linear infinite;
  }
  @keyframes wander1 {
    0% {
      transform: translate(-10dvw, 10dvh) rotate(0deg);
    }
    25% {
      transform: translate(110dvw, 40dvh) rotate(20deg);
    }
    50% {
      transform: translate(50dvw, 90dvh) rotate(-10deg);
    }
    75% {
      transform: translate(-10dvw, 60dvh) rotate(10deg);
    }
    100% {
      transform: translate(-10dvw, 10dvh) rotate(0deg);
    }
  }

  .animate-wander-2 {
    animation: wander2 35s linear infinite;
  }
  @keyframes wander2 {
    0% {
      transform: translate(110dvw, 80dvh) rotate(0deg);
    }
    33% {
      transform: translate(20dvw, 20dvh) rotate(-15deg);
    }
    66% {
      transform: translate(80dvw, 10dvh) rotate(15deg);
    }
    100% {
      transform: translate(110dvw, 80dvh) rotate(0deg);
    }
  }

  .animate-wander-3 {
    animation: wander3 20s ease-in-out infinite;
  }
  @keyframes wander3 {
    0% {
      transform: translate(50dvw, -10dvh) rotate(0deg);
    }
    25% {
      transform: translate(10dvw, 50dvh) rotate(-30deg);
    }
    50% {
      transform: translate(90dvw, 50dvh) rotate(30deg);
    }
    75% {
      transform: translate(50dvw, 110dvh) rotate(0deg);
    }
    100% {
      transform: translate(50dvw, -10dvh) rotate(0deg);
    }
  }

  .animate-wander-4 {
    animation: wander4 40s linear infinite;
  }
  @keyframes wander4 {
    0% {
      transform: translate(10dvw, 90dvh) rotate(0deg);
    }
    50% {
      transform: translate(20dvw, 80dvh) rotate(10deg);
    }
    100% {
      transform: translate(10dvw, 90dvh) rotate(0deg);
    }
  }

  /* Retrasos globales */
  .delay-1700 {
    animation-delay: 1.7s;
  }
  .delay-1900 {
    animation-delay: 1.9s;
  }
  .delay-2100 {
    animation-delay: 2.1s;
  }
  .delay-2500 {
    animation-delay: 2.5s;
  }
  .delay-2000 {
    animation-delay: 2s;
  }
  .delay-3500 {
    animation-delay: 3.5s;
  }
</style>
