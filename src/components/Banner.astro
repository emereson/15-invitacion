---
// src/components/Banner.astro
---

<section
  class="relative w-full h-dvh flex flex-col items-center justify-center overflow-hidden bg-[#010409] banner-parent"
>
  {/* 🔵 1. FOTO DE FONDO */}
  <img
    src="/img/Principal.jpg"
    alt="Maya"
    class="absolute inset-0 w-full h-full object-cover object-[left_35%] opacity-0 banner-img z-0 brightness-[0.25] contrast-[1.4] saturate-[0.6] grayscale-[20%]"
  />

  {/* 🔵 2. CAPAS DE OSCURECIMIENTO */}
  <div class="absolute inset-0 bg-[#020617]/50 z-10 pointer-events-none"></div>
  <div
    class="absolute inset-0 bg-gradient-to-b from-[#020617] via-transparent to-[#020617] z-20"
  >
  </div>
  <div
    class="absolute inset-0 bg-radial-gradient from-transparent via-[#020617]/40 to-[#020617] z-20"
  >
  </div>

  {/* ✨ 3. TEXTURA DE BRILLOS */}
  <div
    class="absolute inset-0 opacity-15 bg-[url('/img/brillos.gif')] bg-repeat z-25 pointer-events-none mix-blend-screen"
  >
  </div>

  {/* 👑 4. CONTENIDO PRINCIPAL */}
  <div
    class="relative z-40 flex flex-col items-center w-full max-w-5xl px-6 text-center"
  >
    <div class="opacity-0 banner-element" style="animation-delay: 0.2s;">
      <span
        class="font-limpia text-[#D4AF37] text-[10px] md:text-xs tracking-[0.8em] uppercase font-black mb-6 block drop-shadow-lg pr-[0.8em]"
      >
        Bienvenidos a la celebración de
      </span>
      <h1
        class="font-script text-6xl md:text-8xl lg:text-[10rem] text-white leading-[0.6] title-shadow"
      >
        Mis 15 Años
      </h1>
    </div>

    <div
      class="opacity-0 banner-element mt-10 md:mt-6"
      style="animation-delay: 0.6s;"
    >
      <h2
        class="font-elegante italic text-7xl md:text-[11rem] font-bold text-[#D4AF37] tracking-tighter gold-shadow"
      >
        Maya
      </h2>
      <div class="flex items-center justify-center gap-4 md:gap-10 mt-4 mb-12">
        <div
          class="h-[2px] w-12 md:w-48 bg-gradient-to-r from-transparent to-[#D4AF37]"
        >
        </div>
        <div
          class="w-3 h-3 rotate-45 border-2 border-[#D4AF37] bg-[#D4AF37] shadow-[0_0_15px_#D4AF37]"
        >
        </div>
        <div
          class="h-[2px] w-12 md:w-48 bg-gradient-to-l from-transparent to-[#D4AF37]"
        >
        </div>
      </div>
    </div>

    <div class="opacity-0 banner-element" style="animation-delay: 1s;">
      <div
        class="relative inline-block px-10 md:px-16 py-3 md:py-4 border-1 border-[#D4AF37]/60 bg-[#0a111e]/40 backdrop-blur-xl rounded-full shadow-2xl"
      >
        <span
          class="font-limpia text-white text-md md:text-3xl tracking-[0.5em] font-bold whitespace-nowrap pr-[0.5em]"
        >
          14 . 08 . 2026
        </span>
      </div>
    </div>
  </div>

  {/* 🖱️ 5. SCROLL */}
  <div
    class="absolute bottom-10 left-1/2 -translate-x-1/2 z-50 flex flex-col items-center opacity-0 scroll-indicator"
    style="animation-delay: 1.8s;"
  >
    <span
      class="font-limpia text-[#D4AF37] text-[10px] tracking-[0.6em] uppercase mb-4 font-black pr-[0.6em]"
    >
      Desliza
    </span>
    <div
      class="w-6 h-10 border-2 border-[#D4AF37] rounded-full flex justify-center p-1.5"
    >
      <div class="w-1.5 h-2.5 bg-[#D4AF37] rounded-full animate-scroll-dot">
      </div>
    </div>
  </div>
</section>

<style is:global>
  /* 🟢 LA MAGIA: Cuando el body tiene la clase, animamos */
  body.invitation-open .banner-img {
    animation: fadeInSlow 3.5s ease-out forwards;
  }

  body.invitation-open .banner-element {
    animation: fadeInUp 1.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  body.invitation-open .scroll-indicator {
    animation: fadeIn 2s ease-out forwards;
  }

  @keyframes fadeInSlow {
    0% {
      opacity: 0;
      transform: scale(1.1);
      filter: blur(10px);
    }
    100% {
      opacity: 1;
      transform: scale(1);
      filter: blur(0);
    }
  }

  @keyframes fadeInUp {
    0% {
      opacity: 0;
      transform: translateY(60px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeIn {
    to {
      opacity: 1;
    }
  }

  .animate-scroll-dot {
    animation: scrollDot 2.2s infinite ease-in-out;
  }
  @keyframes scrollDot {
    0% {
      transform: translateY(0);
      opacity: 0;
    }
    50% {
      opacity: 1;
    }
    100% {
      transform: translateY(16px);
      opacity: 0;
    }
  }

  .title-shadow {
    filter: drop-shadow(0 0 10px rgba(0, 0, 0, 0.9))
      drop-shadow(0 15px 30px rgba(0, 0, 0, 1));
  }
  .gold-shadow {
    filter: drop-shadow(0 0 20px rgba(212, 175, 55, 0.4))
      drop-shadow(0 5px 10px rgba(0, 0, 0, 0.8));
  }
</style>
