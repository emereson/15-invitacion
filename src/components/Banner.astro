---
// src/components/Banner.astro
---

<section
  class="relative w-full h-dvh flex flex-col items-center justify-end overflow-hidden bg-[#010409] banner-parent"
>
  <img
    src="/img/Principal.webp"
    alt="Maya"
    class="absolute inset-0 w-full h-full object-cover object-[left_35%] opacity-0 banner-img z-0 brightness-[0.9] contrast-[1.1] saturate-[0.9]"
  />

  <div
    class="absolute inset-0 bg-linear-to-t from-[#010409] via-[#010409]/90 to-transparent z-20 opacity-90 pointer-events-none"
  >
  </div>

  <div
    class="absolute inset-0 opacity-10 bg-[url('/img/brillos.gif')] bg-repeat z-25 pointer-events-none mix-blend-screen"
  >
  </div>

  <div
    class="relative z-40 flex flex-col items-center justify-center w-full h-1/2 max-w-5xl px-6 text-center pb-20 md:pb-24"
  >
    <div class="opacity-0 banner-element" style="animation-delay: 0.2s;">
      <span
        class="font-limpia text-[#D4AF37] text-[10px] md:text-xs tracking-[0.8em] uppercase font-black mb-4 block drop-shadow-[0_2px_10px_rgba(0,0,0,0.8)] pr-[0.8em]"
      >
        <span class="es-content">Bienvenidos a la celebración de</span>
        <span class="en-content">Welcome to the celebration of</span>
      </span>
      <h1
        class="font-script text-6xl md:text-8xl lg:text-[10rem] text-white leading-[0.6] title-shadow"
      >
        <span class="es-content">Mis 15 Años</span>
        <span class="en-content">My Sweet 15</span>
      </h1>
    </div>

    <div
      class="opacity-0 banner-element mt-8 md:mt-4"
      style="animation-delay: 0.6s;"
    >
      <h2
        class="font-elegante italic text-7xl md:text-[11rem] font-bold text-[#D4AF37] tracking-tighter gold-shadow"
      >
        Maya
      </h2>
      <div
        class="flex items-center justify-center gap-4 md:gap-10 mt-2 mb-8 md:mb-12"
      >
        <div
          class="h-0.5 w-12 md:w-48 bg-linear-to-r from-transparent to-[#D4AF37]"
        >
        </div>
        <div
          class="w-3 h-3 rotate-45 border-2 border-[#D4AF37] bg-[#D4AF37] shadow-[0_0_15px_#D4AF37]"
        >
        </div>
        <div
          class="h-0.5 w-12 md:w-48 bg-linear-to-l from-transparent to-[#D4AF37]"
        >
        </div>
      </div>
    </div>

    <div class="opacity-0 banner-element" style="animation-delay: 1s;">
      <div
        class="relative inline-block px-10 md:px-16 py-3 md:py-4 border border-[#D4AF37]/60 bg-[#0a111e]/60 backdrop-blur-xl rounded-full shadow-2xl"
      >
        <span
          class="font-limpia text-white text-md md:text-3xl tracking-[0.5em] font-bold whitespace-nowrap pr-[0.5em]"
        >
          14 . 08 . 2026
        </span>
      </div>
    </div>
  </div>

  <div
    class="absolute bottom-6 left-1/2 -translate-x-1/2 z-50 flex flex-col items-center opacity-0 scroll-indicator"
    style="animation-delay: 1.8s;"
  >
    <span
      class="font-limpia text-[#D4AF37] text-[9px] tracking-[0.6em] uppercase mb-2 font-black pr-[0.6em]"
    >
      <span class="es-content">Desliza</span>
      <span class="en-content">Swipe</span>
    </span>
    <div
      class="w-5 h-8 border-2 border-[#D4AF37]/50 rounded-full flex justify-center p-1"
    >
      <div class="w-1 h-2 bg-[#D4AF37] rounded-full animate-scroll-dot"></div>
    </div>
  </div>
</section>

<style is:global>
  body.invitation-open .banner-img {
    animation: fadeInSlow 3.5s ease-out forwards;
  }
  body.invitation-open .banner-element {
    animation: fadeInUp 1.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  body.invitation-open .scroll-indicator {
    animation: fadeIn 2s ease-out forwards;
  }

  @keyframes fadeInSlow {
    0% {
      opacity: 0;
      transform: scale(1.1);
      filter: blur(10px);
    }
    100% {
      opacity: 1;
      transform: scale(1);
      filter: blur(0);
    }
  }
  @keyframes fadeInUp {
    0% {
      opacity: 0;
      transform: translateY(60px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes fadeIn {
    to {
      opacity: 1;
    }
  }

  .animate-scroll-dot {
    animation: scrollDot 2.2s infinite ease-in-out;
  }
  @keyframes scrollDot {
    0% {
      transform: translateY(0);
      opacity: 0;
    }
    50% {
      opacity: 1;
    }
    100% {
      transform: translateY(12px);
      opacity: 0;
    }
  }

  .title-shadow {
    filter: drop-shadow(0 0 15px rgba(0, 0, 0, 1));
  }
  .gold-shadow {
    filter: drop-shadow(0 0 25px rgba(212, 175, 55, 0.5))
      drop-shadow(0 5px 10px rgba(0, 0, 0, 1));
  }
</style>
