---
// src/components/LanguageToggle.astro
---

<div class="fixed top-6 right-6 md:top-10 md:right-10 z-100">
  <button
    id="lang-toggle"
    class="flex items-center gap-2 bg-[#0a111e]/60 backdrop-blur-md border border-[#D4AF37]/50 px-4 py-2 rounded-full shadow-[0_4px_15px_rgba(0,0,0,0.3)] hover:bg-[#D4AF37]/20 transition-all cursor-pointer group"
  >
    <span
      id="lang-text-es"
      class="font-elegante text-[#D4AF37] text-sm md:text-base font-bold transition-colors duration-300"
    >
      ES
    </span>
    <div class="w-px h-4 bg-[#D4AF37]/50"></div>
    <span
      id="lang-text-en"
      class="font-elegante text-white/60 text-sm md:text-base group-hover:text-white transition-colors duration-300"
    >
      EN
    </span>
  </button>
</div>

<script>
  function initLanguageToggle() {
    const btn = document.getElementById("lang-toggle");
    // Le decimos a TypeScript exactamente qué tipo de elemento es
    const textEs = document.getElementById(
      "lang-text-es",
    ) as HTMLElement | null;
    const textEn = document.getElementById(
      "lang-text-en",
    ) as HTMLElement | null;
    const html = document.documentElement;

    // Validación principal
    if (!btn || !textEs || !textEn) return;

    // Verificar si el usuario ya había elegido inglés antes
    const currentLang = localStorage.getItem("lang") || "es";
    if (currentLang === "en") {
      html.classList.add("lang-en");
      updateButtonUI("en");
    }

    // Cambiar idioma al hacer clic
    btn.addEventListener("click", () => {
      const isEn = html.classList.toggle("lang-en");
      const newLang = isEn ? "en" : "es";
      localStorage.setItem("lang", newLang);
      updateButtonUI(newLang);
    });

    // Función que actualiza los colores
    function updateButtonUI(lang: string) {
      // 🛑 Re-validación de seguridad para que el linter no se queje aquí adentro
      if (!textEs || !textEn) return;

      if (lang === "en") {
        textEs.classList.replace("text-[#D4AF37]", "text-white/60");
        textEs.classList.remove("font-bold");
        textEn.classList.replace("text-white/60", "text-[#D4AF37]");
        textEn.classList.add("font-bold");
      } else {
        textEn.classList.replace("text-[#D4AF37]", "text-white/60");
        textEn.classList.remove("font-bold");
        textEs.classList.replace("text-white/60", "text-[#D4AF37]");
        textEs.classList.add("font-bold");
      }
    }
  }

  document.addEventListener("DOMContentLoaded", initLanguageToggle);
</script>
