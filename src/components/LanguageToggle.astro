---
// src/components/LanguageToggle.astro
---

<div class="fixed top-6 right-6 md:top-10 md:right-10 z-[100]">
  <button
    id="lang-toggle"
    class="relative flex items-center p-1 bg-[#0a111e]/80 backdrop-blur-xl border border-[#D4AF37]/40 rounded-full shadow-[0_10px_25px_rgba(0,0,0,0.5)] cursor-pointer w-24 md:w-28 h-10 md:h-12 overflow-hidden group focus:outline-none"
    aria-label="Cambiar idioma / Toggle language"
  >
    {/* 🟢 PASTILLA DORADA DESLIZANTE */}
    <div
      id="lang-slider"
      class="absolute left-1 top-1 w-[calc(50%-4px)] h-[calc(100%-8px)] bg-linear-to-r from-[#D4AF37] to-[#e6d089] rounded-full transition-transform duration-500 ease-[cubic-bezier(0.68,-0.55,0.265,1.55)] shadow-[0_0_15px_rgba(212,175,55,0.4)] translate-x-0"
    >
    </div>

    {/* 🟢 TEXTOS DE LOS IDIOMAS */}
    <span
      id="lang-text-es"
      class="relative z-10 flex-1 text-center font-elegante text-xs md:text-sm font-bold tracking-widest text-[#0a111e] transition-colors duration-500"
    >
      ES
    </span>
    <span
      id="lang-text-en"
      class="relative z-10 flex-1 text-center font-elegante text-xs md:text-sm font-bold tracking-widest text-white/70 transition-colors duration-500"
    >
      EN
    </span>
  </button>
</div>

<script>
  function initLanguageToggle() {
    const btn = document.getElementById("lang-toggle");
    const slider = document.getElementById("lang-slider");
    const textEs = document.getElementById("lang-text-es");
    const textEn = document.getElementById("lang-text-en");
    const html = document.documentElement;

    // Validación principal
    if (!btn || !slider || !textEs || !textEn) return;

    // Verificar si el usuario ya había elegido inglés antes
    const currentLang = localStorage.getItem("lang") || "es";
    if (currentLang === "en") {
      html.classList.add("lang-en");
      updateButtonUI("en");
    }

    // Cambiar idioma al hacer clic
    btn.addEventListener("click", () => {
      const isEn = html.classList.toggle("lang-en");
      const newLang = isEn ? "en" : "es";
      localStorage.setItem("lang", newLang);
      updateButtonUI(newLang);
    });

    // Función que actualiza la posición del slider y los colores
    function updateButtonUI(lang: string) {
      if (!slider || !textEs || !textEn) return;

      if (lang === "en") {
        // Deslizar a la derecha
        slider.classList.remove("translate-x-0");
        slider.classList.add("translate-x-full");

        // El texto "EN" se vuelve oscuro (está sobre el dorado) y el "ES" se vuelve blanco
        textEs.classList.replace("text-[#0a111e]", "text-white/70");
        textEn.classList.replace("text-white/70", "text-[#0a111e]");
      } else {
        // Deslizar a la izquierda
        slider.classList.remove("translate-x-full");
        slider.classList.add("translate-x-0");

        // El texto "ES" se vuelve oscuro (está sobre el dorado) y el "EN" se vuelve blanco
        textEn.classList.replace("text-[#0a111e]", "text-white/70");
        textEs.classList.replace("text-white/70", "text-[#0a111e]");
      }
    }
  }

  // Se ejecuta al cargar la página
  document.addEventListener("DOMContentLoaded", initLanguageToggle);
</script>
