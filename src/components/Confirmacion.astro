---
// src/components/Confirmacion.astro
---

<section
  class="relative w-full py-16 flex justify-center items-center bg-slate-50 overflow-hidden px-4 md:px-8"
>
  {/* 🟢 CONTENEDOR PRINCIPAL TIPO TARJETA (Mismo estilo que Contactos) */}
  <div
    class="relative z-10 w-full max-w-6xl mx-auto flex flex-col md:flex-row gap-16 md:gap-0
    md:border md:border-[#D4AF37] md:rounded-[2.5rem] md:shadow-[0_20px_50px_rgba(0,0,0,0.4)]
    transition-all duration-700 md:hover:shadow-[0_0_40px_rgba(212,175,55,0.25)]"
  >
    {/* 🟢 COLUMNA DE LA IMAGEN */}
    <div
      class="relative w-full md:w-1/2 min-h-125 md:min-h-0 h-[55dvh] md:h-auto z-20 scroll-reveal
      border border-[#D4AF37] rounded-3xl md:border-none md:rounded-none"
    >
      <div
        class="absolute inset-0 overflow-hidden rounded-3xl md:rounded-none md:rounded-l-[2.5rem] shadow-[0_15px_30px_rgba(0,0,0,0.5)] md:shadow-none"
      >
        <img
          src="/img/6.webp"
          alt="Maya Quinceañera"
          class="w-full h-full object-cover transition-transform duration-1000 hover:scale-105"
        />
        {/* Sombra interna para fusionar (Misma de Contactos) */}
        <div
          class="absolute inset-0 shadow-[inset_0_-40px_40px_-20px_rgba(2,6,23,0.8)] md:shadow-[inset_-30px_0_40px_-30px_rgba(2,6,23,0.9)] pointer-events-none"
        >
        </div>
      </div>

      {/* 🌸 FLOR IZQUIERDA (Decorativa) */}
      <img
        src="/img/rosa2.webp"
        alt="Flor Decorativa"
        class="absolute -bottom-12 -left-8 w-36 max-md:hidden md:w-56 -rotate-45 animate-sway-delayed pointer-events-none z-30 scroll-reveal delay-500 opacity-90 drop-shadow-[0_10px_15px_rgba(0,0,0,0.6)]"
      />
    </div>

    {/* 🟢 COLUMNA DEL FORMULARIO (Fondo oscuro con hojas) */}
    <div
      class="relative w-full md:w-1/2 min-h-150 px-6 py-16 md:min-h-200 md:p-12 lg:p-16 flex flex-col justify-center items-center text-center z-10
      border border-[#D4AF37] rounded-3xl md:border-none md:rounded-none"
    >
      <div
        class="absolute inset-0 bg-[#0a111e]/50 backdrop-blur-xl rounded-3xl md:rounded-none md:rounded-r-[2.5rem] overflow-hidden z-0 md:shadow-[inset_20px_0_40px_-20px_rgba(2,6,23,0.9)]"
      >
        <div
          class="absolute inset-0 bg-[url('/img/hoja.webp')] bg-repeat bg-cover bg-center mix-blend-overlay"
        >
        </div>
      </div>

      {/* 🌸 FLOR DERECHA (Arriba) */}
      <img
        src="/img/rosa2.webp"
        alt="Flor"
        class="absolute -top-12 -right-8 w-36 md:w-52 rotate-135 animate-sway pointer-events-none z-30 scroll-reveal delay-300 opacity-90 drop-shadow-[0_10px_15px_rgba(0,0,0,0.6)]"
      />
      {/* 🌸 FLOR EXTRA (Solo móvil) */}
      <img
        src="/img/rosa2.webp"
        alt="Flor"
        class="absolute -bottom-10 -left-10 w-32 md:hidden -rotate-45 animate-sway-delayed pointer-events-none z-20 scroll-reveal delay-500 opacity-80 drop-shadow-[0_5px_10px_rgba(0,0,0,0.5)]"
      />

      <div class="relative z-30 w-full flex flex-col items-center">
        {/* TÍTULO */}
        <div
          class="scroll-reveal text-center mb-8 flex flex-col items-center w-full"
        >
          <h3
            class="font-script text-5xl md:text-6xl text-[#D4AF37] mb-2 drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)]"
          >
            Confirmación
          </h3>
          <p
            class="font-limpia text-slate-200 text-[10px] md:text-xs tracking-[0.3em] uppercase opacity-90"
          >
            ¿Nos acompañas en este día?
          </p>
        </div>

        {/* 🟢 FORMULARIO RSVP (Estilo Dark Mode Glassmorphism) */}
        <form
          id="rsvp-form"
          class="w-full max-w-sm space-y-5 scroll-reveal delay-200"
        >
          <div class="flex flex-col items-start">
            <label
              class="font-elegante text-xs text-slate-300 uppercase tracking-widest mb-2 ml-1"
            >
              Nombre Completo
            </label>
            <input
              type="text"
              name="from_name"
              required
              class="w-full px-4 py-3 bg-white/5 border border-white/10 rounded-xl text-white placeholder-slate-400 focus:border-[#D4AF37] focus:bg-[#D4AF37]/10 focus:ring-1 focus:ring-[#D4AF37] outline-none transition-all duration-300 font-elegante shadow-inner"
              placeholder="Tu nombre y apellido"
            />
          </div>

          <div class="flex flex-col items-start">
            <label
              class="font-elegante text-xs text-slate-300 uppercase tracking-widest mb-2 ml-1"
            >
              ¿Asistirás?
            </label>
            <select
              name="attendance"
              required
              class="w-full px-4 py-3 bg-[#0a111e] md:bg-white/5 border border-white/10 rounded-xl text-white focus:border-[#D4AF37] focus:bg-[#D4AF37]/10 outline-none transition-all duration-300 font-elegante appearance-none shadow-inner"
            >
              <option value="Si, asistiré" class="bg-[#0a111e] text-white"
                >Sí, asistiré con gusto</option
              >
              <option value="No podré asistir" class="bg-[#0a111e] text-white"
                >Lo siento, no podré asistir</option
              >
            </select>
          </div>

          <div class="flex flex-col items-start">
            <label
              class="font-elegante text-xs text-slate-300 uppercase tracking-widest mb-2 ml-1"
            >
              Cantidad de Personas
            </label>
            <input
              type="number"
              name="guests"
              min="1"
              max="10"
              required
              class="w-full px-4 py-3 bg-white/5 border border-white/10 rounded-xl text-white placeholder-slate-400 focus:border-[#D4AF37] focus:bg-[#D4AF37]/10 outline-none transition-all duration-300 font-elegante shadow-inner"
              placeholder="Ej. 2"
            />
          </div>

          {/* Botón de Submit (Estilo Contactos) */}
          <button
            type="submit"
            id="submit-btn"
            class="group relative w-full overflow-hidden mt-2 bg-linear-to-br from-[#162642] to-[#0a111e] border border-[#D4AF37]/40 py-4 rounded-xl transition-all duration-500 hover:bg-[#D4AF37] hover:border-[#D4AF37] hover:scale-[1.02] shadow-[0_0_15px_rgba(0,0,0,0.5)] hover:shadow-[0_0_20px_rgba(212,175,55,0.4)]"
          >
            <span
              class="relative z-10 font-limpia text-[#c1b07a] group-hover:text-[#0a111e] tracking-[0.3em] uppercase text-sm font-bold transition-colors duration-300"
            >
              Enviar Confirmación
            </span>
          </button>

          <p
            id="form-status"
            class="text-[10px] font-elegante uppercase tracking-widest mt-4 opacity-0 transition-opacity duration-500 text-center w-full"
          >
          </p>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  /* 🟢 ANIMACIÓN DE REVELADO */
  .scroll-reveal {
    opacity: 0;
    transform: translateY(30px);
    transition: all 1s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .scroll-reveal.active {
    opacity: 1;
    transform: translateY(0);
  }

  /* Delays */
  .delay-200 {
    transition-delay: 0.2s;
  }
  .delay-300 {
    transition-delay: 0.3s;
  }
  .delay-400 {
    transition-delay: 0.4s;
  }
  .delay-500 {
    transition-delay: 0.5s;
  }

  /* 🟢 BALANCEO */
  .animate-sway {
    animation: sway 8s ease-in-out infinite;
  }
  .animate-sway-delayed {
    animation: sway 9s ease-in-out 3s infinite reverse;
  }

  @keyframes sway {
    0%,
    100% {
      transform: translateY(0) rotate(var(--tw-rotate, 0deg));
    }
    50% {
      transform: translateY(-12px) rotate(calc(var(--tw-rotate, 0deg) + 6deg));
    }
  }

  /* Modificar el color del icono de flecha nativo en los selects (para navegadores Webkit) */
  select {
    background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%23D4AF37' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M6 8l4 4 4-4'/%3e%3c/svg%3e");
    background-position: right 1rem center;
    background-repeat: no-repeat;
    background-size: 1.5em 1.5em;
  }
</style>

{/* 🟢 INTEGRACIÓN EMAILJS */}
<script
  type="text/javascript"
  src="https://cdn.jsdelivr.net/npm/@emailjs/browser@3/dist/email.min.js"
></script>

<script>
  // Inicializa con tu PUBLIC KEY de EmailJS
  // @ts-ignore
  emailjs.init("TU_PUBLIC_KEY");

  function initConfirmacionReveal() {
    const btn = document.getElementById("submit-btn") as HTMLButtonElement;
    const form = document.getElementById("rsvp-form") as HTMLFormElement;
    const status = document.getElementById("form-status");
    const btnText = btn?.querySelector("span");

    form?.addEventListener("submit", function (event) {
      event.preventDefault();

      if (btnText) btnText.innerText = "ENVIANDO...";
      btn.disabled = true;

      const serviceID = "TU_SERVICE_ID";
      const templateID = "TU_TEMPLATE_ID";

      // @ts-ignore
      emailjs.sendForm(serviceID, templateID, this).then(
        () => {
          if (btnText) btnText.innerText = "¡ENVIADO!";
          if (status) {
            status.innerText = "¡Gracias! Tu respuesta ha sido enviada.";
            status.classList.remove("text-red-400");
            status.classList.add("text-[#D4AF37]", "opacity-100");
          }
          form.reset();
        },
        (err: unknown) => {
          if (btnText) btnText.innerText = "ERROR";
          btn.disabled = false;
          if (status) {
            status.innerText = "Hubo un error. Intenta de nuevo.";
            status.classList.remove("text-[#D4AF37]");
            status.classList.add("text-red-400", "opacity-100");
          }
          console.error(JSON.stringify(err));
        },
      );
    });

    // Animación Scroll
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) entry.target.classList.add("active");
        });
      },
      { threshold: 0.15, rootMargin: "0px 0px -50px 0px" },
    );

    document
      .querySelectorAll(".scroll-reveal")
      .forEach((el) => observer.observe(el));
  }

  // Si usas view transitions de Astro, usa 'astro:page-load'
  document.addEventListener("DOMContentLoaded", initConfirmacionReveal);
</script>
