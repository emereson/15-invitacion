---
// src/components/Confirmacion.astro
---

<section
  class="relative w-full py-16 flex justify-center items-center bg-slate-50 overflow-hidden px-4 md:px-8"
>
  {/* 🟢 CONTENEDOR PRINCIPAL TIPO TARJETA */}
  <div
    class="relative z-10 w-full max-w-6xl mx-auto flex flex-col md:flex-row gap-16 md:gap-0 md:border md:border-[#D4AF37] md:rounded-[2.5rem] md:shadow-[0_20px_50px_rgba(0,0,0,0.4)] transition-all duration-700 md:hover:shadow-[0_0_40px_rgba(212,175,55,0.25)]"
  >
    {/* 🟢 COLUMNA DE LA IMAGEN */}
    <div
      class="relative w-full md:w-1/2 min-h-125 md:min-h-0 h-[55dvh] md:h-auto z-20 scroll-reveal border border-[#D4AF37] rounded-3xl md:border-none md:rounded-none"
    >
      <div
        class="absolute inset-0 overflow-hidden rounded-3xl md:rounded-none md:rounded-l-[2.5rem] shadow-[0_15px_30px_rgba(0,0,0,0.5)] md:shadow-none"
      >
        <img
          src="/img/6.webp"
          alt="Maya Quinceañera"
          class="w-full h-full object-cover transition-transform duration-1000 hover:scale-105"
        />
        <div
          class="absolute inset-0 shadow-[inset_0_-40px_40px_-20px_rgba(2,6,23,0.8)] md:shadow-[inset_-30px_0_40px_-30px_rgba(2,6,23,0.9)] pointer-events-none"
        >
        </div>
      </div>
      <img
        src="/img/rosa2.webp"
        alt="Flor Decorativa"
        class="absolute -bottom-12 -left-8 w-36 max-md:hidden md:w-56 -rotate-45 animate-sway-delayed pointer-events-none z-30 scroll-reveal delay-500 opacity-90 drop-shadow-[0_10px_15px_rgba(0,0,0,0.6)]"
      />
    </div>

    {/* 🟢 COLUMNA DEL FORMULARIO */}
    <div
      class="relative w-full md:w-1/2 min-h-150 px-6 py-16 md:min-h-200 md:p-12 lg:p-16 flex flex-col justify-center items-center text-center z-10 border border-[#D4AF37] rounded-3xl md:border-none md:rounded-none"
    >
      <div
        class="absolute inset-0 bg-[#0a111e]/50 backdrop-blur-xl rounded-3xl md:rounded-none md:rounded-r-[2.5rem] overflow-hidden z-0 md:shadow-[inset_20px_0_40px_-20px_rgba(2,6,23,0.9)]"
      >
        <div
          class="absolute inset-0 bg-[url('/img/hoja.webp')] bg-repeat bg-cover bg-center mix-blend-overlay"
        >
        </div>
      </div>

      <img
        src="/img/rosa2.webp"
        alt="Flor"
        class="absolute -top-12 -right-8 w-36 md:w-52 rotate-135 animate-sway pointer-events-none z-30 scroll-reveal delay-300 opacity-90 drop-shadow-[0_10px_15px_rgba(0,0,0,0.6)]"
      />
      <img
        src="/img/rosa2.webp"
        alt="Flor"
        class="absolute -bottom-10 -left-10 w-32 md:hidden -rotate-45 animate-sway-delayed pointer-events-none z-20 scroll-reveal delay-500 opacity-80 drop-shadow-[0_5px_10px_rgba(0,0,0,0.5)]"
      />

      <div class="relative z-30 w-full flex flex-col items-center">
        <div
          class="scroll-reveal text-center mb-8 flex flex-col items-center w-full"
        >
          <h3
            class="font-script text-5xl md:text-6xl text-[#D4AF37] mb-2 drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)]"
          >
            <span class="es-content">Confirmación</span>
            <span class="en-content">RSVP</span>
          </h3>
          <p
            class="font-limpia text-slate-200 text-[10px] md:text-xs tracking-[0.3em] uppercase opacity-90"
          >
            <span class="es-content">¿Nos acompañas en este día?</span>
            <span class="en-content">Will you join us on this day?</span>
          </p>
        </div>

        <form
          id="rsvp-form"
          class="w-full max-w-sm space-y-5 scroll-reveal delay-200"
        >
          <div class="flex flex-col items-start">
            <label
              class="font-elegante text-xs text-slate-300 uppercase tracking-widest mb-2 ml-1"
            >
              <span class="es-content">Nombre Completo</span>
              <span class="en-content">Full Name</span>
            </label>
            <input
              type="text"
              name="from_name"
              required
              class="w-full px-4 py-3 bg-white/5 border border-white/10 rounded-xl text-white placeholder-slate-400 focus:border-[#D4AF37] focus:bg-[#D4AF37]/10 focus:ring-1 focus:ring-[#D4AF37] outline-none transition-all duration-300 font-elegante shadow-inner"
              placeholder="Nombre y apellido / First and last name"
            />
          </div>

          <div class="flex flex-col items-start">
            <label
              class="font-elegante text-xs text-slate-300 uppercase tracking-widest mb-2 ml-1"
            >
              <span class="es-content">¿Asistirás?</span>
              <span class="en-content">Will you attend?</span>
            </label>
            <select
              name="attendance"
              required
              class="w-full px-4 py-3 bg-[#0a111e] md:bg-white/5 border border-white/10 rounded-xl text-white focus:border-[#D4AF37] focus:bg-[#D4AF37]/10 outline-none transition-all duration-300 font-elegante appearance-none shadow-inner"
            >
              <option value="Si, asistiré" class="bg-[#0a111e] text-white"
                >Sí, asistiré / Yes, I will attend</option
              >
              <option value="No podré asistir" class="bg-[#0a111e] text-white"
                >No podré asistir / I won't be able to attend</option
              >
            </select>
          </div>

          <div class="flex flex-col items-start">
            <label
              class="font-elegante text-xs text-slate-300 uppercase tracking-widest mb-2 ml-1"
            >
              <span class="es-content">Cantidad de Personas</span>
              <span class="en-content">Number of Guests</span>
            </label>
            <input
              type="number"
              name="guests"
              min="1"
              max="10"
              required
              class="w-full px-4 py-3 bg-white/5 border border-white/10 rounded-xl text-white placeholder-slate-400 focus:border-[#D4AF37] focus:bg-[#D4AF37]/10 outline-none transition-all duration-300 font-elegante shadow-inner"
              placeholder="Ej. / E.g. 2"
            />
          </div>

          <button
            type="submit"
            id="submit-btn"
            class="group relative w-full overflow-hidden mt-4 bg-linear-to-br from-[#162642] to-[#0a111e] border border-[#D4AF37]/40 py-4 rounded-xl transition-all duration-500 hover:bg-[#D4AF37] hover:border-[#D4AF37] hover:scale-[1.02] shadow-[0_0_15px_rgba(0,0,0,0.5)] hover:shadow-[0_0_20px_rgba(212,175,55,0.4)]"
          >
            <span
              id="btn-text"
              class="relative z-10 font-limpia text-[#c1b07a] tracking-[0.3em] uppercase text-sm font-bold transition-colors duration-300"
            >
              <span class="es-content">Enviar Confirmación</span>
              <span class="en-content">Send RSVP</span>
            </span>
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

{/* 🟢 MODAL FLOTANTE DE RESPUESTA (Toast / Alert) */}
<dialog
  id="status-modal"
  class="backdrop:bg-[#0a111e]/80 backdrop:backdrop-blur-md bg-transparent border-none p-0 w-full max-w-md m-auto focus:outline-none open:flex justify-center items-center"
>
  <div
    class="relative w-full mx-4 md:mx-0 bg-linear-to-b from-[#111d33] to-[#0a111e] border border-[#D4AF37]/50 rounded-2xl shadow-[0_20px_50px_rgba(0,0,0,0.5)] p-8 text-center overflow-hidden modal-content"
  >
    {/* Decoración sutil de fondo en el modal */}
    <div
      class="absolute inset-0 bg-[url('/img/hoja.webp')] bg-repeat bg-cover bg-center mix-blend-overlay opacity-20 pointer-events-none"
    >
    </div>

    <div class="relative z-10 flex flex-col items-center">
      {/* Ícono dinámico (se cambia por JS) */}
      <div id="modal-icon" class="mb-4">
        {/* SVG Success por defecto */}
        <svg
          class="w-16 h-16 text-[#D4AF37]"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"
            d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
      </div>

      <h4 id="modal-title" class="font-script text-4xl text-[#D4AF37] mb-2">
        <span class="es-content">¡Gracias!</span>
        <span class="en-content">Thank you!</span>
      </h4>
      <p
        id="modal-message"
        class="font-elegante text-slate-200 text-sm tracking-wider mb-6"
      >
        <span class="es-content"
          >Tu respuesta ha sido enviada correctamente.</span
        >
        <span class="en-content">Your response has been sent successfully.</span
        >
      </p>

      <button
        id="modal-close-btn"
        class="px-8 py-3 bg-white/10 hover:bg-[#D4AF37]/20 border border-[#D4AF37]/50 text-[#D4AF37] rounded-full font-limpia text-xs tracking-widest uppercase transition-colors duration-300"
      >
        <span class="es-content">Cerrar</span>
        <span class="en-content">Close</span>
      </button>
    </div>
  </div>
</dialog>

<style>
  /* Animaciones existentes... */
  .scroll-reveal {
    opacity: 0;
    transform: translateY(30px);
    transition: all 1s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .scroll-reveal.active {
    opacity: 1;
    transform: translateY(0);
  }
  .delay-200 {
    transition-delay: 0.2s;
  }
  .delay-300 {
    transition-delay: 0.3s;
  }
  .delay-400 {
    transition-delay: 0.4s;
  }
  .delay-500 {
    transition-delay: 0.5s;
  }

  .animate-sway {
    animation: sway 8s ease-in-out infinite;
  }
  .animate-sway-delayed {
    animation: sway 9s ease-in-out 3s infinite reverse;
  }

  @keyframes sway {
    0%,
    100% {
      transform: translateY(0) rotate(var(--tw-rotate, 0deg));
    }
    50% {
      transform: translateY(-12px) rotate(calc(var(--tw-rotate, 0deg) + 6deg));
    }
  }

  select {
    background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%23D4AF37' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M6 8l4 4 4-4'/%3e%3c/svg%3e");
    background-position: right 1rem center;
    background-repeat: no-repeat;
    background-size: 1.5em 1.5em;
  }

  /* 🟢 ANIMACIÓN DEL MODAL FLOTANTE */
  #status-modal[open] {
    animation: fadeIn 0.3s ease-out;
  }
  #status-modal[open] .modal-content {
    animation: slideUp 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(30px) scale(0.95);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
</style>

<script>
  function initConfirmacionReveal() {
    const btn = document.getElementById("submit-btn") as HTMLButtonElement;
    const form = document.getElementById("rsvp-form") as HTMLFormElement;
    // Seleccionamos el contenedor de texto del botón por su nuevo ID
    const btnText = document.getElementById("btn-text");

    // Elementos del Modal
    const modal = document.getElementById("status-modal") as HTMLDialogElement;
    const modalTitle = document.getElementById("modal-title");
    const modalMessage = document.getElementById("modal-message");
    const modalIcon = document.getElementById("modal-icon");
    const modalCloseBtn = document.getElementById("modal-close-btn");

    const API_URL = "https://form.alipioponce.com/api/rsvp";

    // Función para mostrar el modal con contenido dinámico BILINGÜE
    const showModal = (type: "success" | "error") => {
      if (!modal || !modalTitle || !modalMessage || !modalIcon) return;

      if (type === "success") {
        modalTitle.className = "font-script text-4xl text-[#D4AF37] mb-2";
        modalTitle.innerHTML = `<span class="es-content">¡Gracias!</span><span class="en-content">Thank you!</span>`;
        modalMessage.innerHTML = `<span class="es-content">Tu respuesta ha sido enviada correctamente. ¡Nos vemos en la fiesta!</span><span class="en-content">Your RSVP has been sent successfully. See you at the party!</span>`;
        modalIcon.innerHTML = `<svg class="w-16 h-16 text-[#D4AF37]" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>`;
      } else {
        modalTitle.className = "font-script text-4xl text-red-400 mb-2";
        modalTitle.innerHTML = `<span class="es-content">Lo sentimos</span><span class="en-content">We are sorry</span>`;
        modalMessage.innerHTML = `<span class="es-content">Hubo un problema al enviar tu confirmación. Por favor, intenta de nuevo o contáctanos.</span><span class="en-content">There was an issue sending your RSVP. Please try again or contact us.</span>`;
        modalIcon.innerHTML = `<svg class="w-16 h-16 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>`;
      }

      document.body.style.overflow = "hidden"; // Bloquea scroll trasero
      modal.showModal();
    };

    // Función para cerrar modal
    const closeModal = () => {
      if (!modal) return;
      modal.close();
      document.body.style.overflow = ""; // Restaura scroll
    };

    modalCloseBtn?.addEventListener("click", closeModal);

    // Cerrar al hacer click fuera
    modal?.addEventListener("click", (e) => {
      if (e.target === modal) closeModal();
    });

    form?.addEventListener("submit", async function (event) {
      event.preventDefault();

      // Guardamos el HTML original para restaurarlo después
      const originalHTML = btnText ? btnText.innerHTML : "";

      if (btnText) {
        // Inyectamos estado de carga bilingüe
        btnText.innerHTML = `<span class="es-content">ENVIANDO...</span><span class="en-content">SENDING...</span>`;
      }
      btn.disabled = true;

      const formData = new FormData(form);
      const data = {
        from_name: formData.get("from_name"),
        attendance: formData.get("attendance"),
        guests: formData.get("guests"),
      };

      try {
        const response = await fetch(API_URL, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json",
          },
          body: JSON.stringify(data),
        });

        if (response.ok) {
          form.reset();
          showModal("success");
        } else {
          showModal("error");
        }
      } catch (error) {
        console.error("Error al enviar RSVP:", error);
        showModal("error");
      } finally {
        // Restaurar estado original del botón siempre
        if (btnText) btnText.innerHTML = originalHTML;
        btn.disabled = false;
      }
    });

    // Animación Scroll
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) entry.target.classList.add("active");
        });
      },
      { threshold: 0.15, rootMargin: "0px 0px -50px 0px" },
    );

    document
      .querySelectorAll(".scroll-reveal")
      .forEach((el) => observer.observe(el));
  }

  document.addEventListener("DOMContentLoaded", initConfirmacionReveal);
</script>
