---
// src/components/Ubicaciones.astro
---

<section
  class="relative w-full py-16 pt-6 z-10 flex justify-center items-center bg-slate-50 overflow-visible overflow-x-clip px-4 md:px-8"
>
  {/* 🟢 CONTENEDOR PRINCIPAL UNIFICADO */}
  <div
    class="relative z-10 w-full max-w-6xl mx-auto flex flex-col md:flex-row-reverse gap-16 md:gap-0
    md:border md:border-[#D4AF37] md:rounded-[2.5rem] md:shadow-[0_20px_50px_rgba(0,0,0,0.4)]
    transition-all duration-700 md:hover:shadow-[0_0_40px_rgba(212,175,55,0.25)]"
  >
    {/* 🟢 COLUMNA DE LA IMAGEN (Derecha en desktop) */}
    <div
      class="relative w-full md:w-1/2 min-h-160 md:min-h-0 h-[55dvh] md:h-auto z-20 scroll-reveal
      border border-[#D4AF37] rounded-3xl md:border-none md:rounded-none"
    >
      {/* ENVOLTURA DE LA IMAGEN */}
      <div
        class="absolute inset-0 overflow-hidden rounded-3xl md:rounded-none md:rounded-r-[2.5rem] shadow-[0_15px_30px_rgba(0,0,0,0.5)] md:shadow-none"
      >
        <img
          src="/img/3.webp"
          alt="Lugar del evento"
          class="w-full h-full object-cover transition-transform duration-1000 hover:scale-105"
        />
        {/* Sombra interna para fusionar (Invertida para la izquierda) */}
      </div>

      {/* 🌸 FLOR DECORATIVA DE LA IMAGEN */}
      <img
        src="/img/flor3.webp"
        alt="Flor Decorativa"
        class="absolute -bottom-12 -right-8 w-36 max-md:hidden md:w-56 rotate-45 animate-sway-delayed pointer-events-none z-30 scroll-reveal delay-500 opacity-90 drop-shadow-[0_10px_15px_rgba(0,0,0,0.6)]"
      />
    </div>

    {/* 🟢 COLUMNA DE TEXTO / UBICACIONES (Izquierda en desktop) */}
    <div
      class="relative w-full md:w-1/2 min-h-160 px-6 py-16 md:min-h-200 md:p-12 lg:p-16 flex flex-col justify-center items-center text-center z-10
      border border-[#D4AF37] rounded-3xl md:border-none md:rounded-none"
    >
      {/* Fondo Azul Noche Translúcido */}
      <div
        class="absolute inset-0 bg-[#0a111e]/50 backdrop-blur-xl rounded-3xl md:rounded-none md:rounded-l-[2.5rem] overflow-hidden z-0 md:shadow-[inset_-20px_0_40px_-20px_rgba(2,6,23,0.9)]"
      >
        <div
          class="absolute inset-0 bg-[url('/img/hoja.webp')] bg-repeat bg-cover bg-center mix-blend-overlay"
        >
        </div>
      </div>

      {/* 🌸 FLORES DECORATIVAS DEL TEXTO */}
      <img
        src="/img/flor3.webp"
        alt="Flor"
        class="absolute -top-10 -left-8 w-36 md:w-52 -rotate-135 animate-sway pointer-events-none z-30 scroll-reveal delay-300 opacity-90 drop-shadow-[0_10px_15px_rgba(0,0,0,0.6)]"
      />
      {/* Flor extra solo en móvil */}
      <img
        src="/img/flor3.webp"
        alt="Flor"
        class="absolute -bottom-10 -right-10 w-32 md:hidden rotate-45 animate-sway-delayed pointer-events-none z-20 scroll-reveal delay-500 opacity-80 drop-shadow-[0_5px_10px_rgba(0,0,0,0.5)]"
      />

      {/* 🟢 CONTENIDO DE TEXTO */}
      <div class="relative z-30 w-full flex flex-col items-center">
        {/* ⛪ IGLESIA */}
        <div class="scroll-reveal flex flex-col items-center mb-10 w-full">
          <h3
            class="font-script text-5xl md:text-6xl text-[#D4AF37] mb-3 drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)]"
          >
            <span class="es-content">Ceremonia Religiosa</span>
            <span class="en-content">Religious Ceremony</span>
          </h3>
          <p
            class="font-elegante text-xl md:text-2xl text-slate-50 font-bold uppercase tracking-widest mb-2"
          >
            San Phillip Neri Church
          </p>
          <div
            class="flex flex-col items-center space-y-1 text-slate-200 font-elegante opacity-90"
          >
            <span class="text-lg font-medium text-[#c1b07a]">4:00 PM</span>
            <span class="text-sm md:text-base"
              >3021 Grand Concourse, Bronx, NY 10468</span
            >
          </div>
          <a
            href="https://www.google.com/maps/search/?api=1&query=3021+Grand+Concourse+Bronx+NY+10468"
            target="_blank"
            class="mt-6 flex items-center gap-2 px-6 py-2.5 border border-[#D4AF37]/60 text-[#c1b07a] bg-white/5 hover:bg-[#D4AF37] hover:text-[#0a111e] hover:border-[#D4AF37] hover:shadow-[0_0_15px_rgba(212,175,55,0.4)] transition-all duration-300 rounded-full font-elegante tracking-widest text-sm group"
          >
            <svg
              class="w-4 h-4 transition-transform group-hover:-translate-y-1"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
              ></path>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            <span class="es-content">VER MAPA</span>
            <span class="en-content">VIEW MAP</span>
          </a>
        </div>

        {/* ➖ SEPARADOR */}
        <div
          class="w-20 h-px bg-linear-to-r from-transparent via-[#D4AF37] to-transparent mb-10 scroll-reveal opacity-50"
        >
        </div>

        {/* 🥂 LUGAR DE EVENTO */}
        <div class="scroll-reveal flex flex-col items-center mb-10 w-full">
          <h3
            class="font-script text-5xl md:text-6xl text-[#D4AF37] mb-3 drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)]"
          >
            <span class="es-content">Recepción</span>
            <span class="en-content">Reception</span>
          </h3>
          <p
            class="font-elegante text-xl md:text-2xl text-slate-50 font-bold uppercase tracking-widest mb-2"
          >
            Maestro's Caterers
          </p>
          <div
            class="flex flex-col items-center space-y-1 text-slate-200 font-elegante opacity-90"
          >
            <span class="text-lg font-medium text-[#c1b07a]">7:30 PM</span>
            <span class="text-sm md:text-base"
              >1703 Bronxdale Ave. Bronx, NY 10462</span
            >
          </div>
          <a
            href="https://www.google.com/maps/search/?api=1&query=1703+Bronxdale+Ave+Bronx+NY+10462"
            target="_blank"
            class="mt-6 flex items-center gap-2 px-6 py-2.5 border border-[#D4AF37]/60 text-[#c1b07a] bg-white/5 hover:bg-[#D4AF37] hover:text-[#0a111e] hover:border-[#D4AF37] hover:shadow-[0_0_15px_rgba(212,175,55,0.4)] transition-all duration-300 rounded-full font-elegante tracking-widest text-sm group"
          >
            <svg
              class="w-4 h-4 transition-transform group-hover:-translate-y-1"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
              ></path>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            <span class="es-content">VER MAPA</span>
            <span class="en-content">VIEW MAP</span>
          </a>
        </div>

        {/* 👔 CÓDIGO DE VESTIMENTA */}
        <div
          class="scroll-reveal delay-200 w-full max-w-sm mt-2 p-6 bg-white/5 border border-white/10 rounded-2xl flex flex-col items-center transition-all hover:bg-[#D4AF37]/10 hover:border-[#D4AF37]/30"
        >
          <span
            class="font-elegante text-[10px] md:text-xs tracking-[0.4em] text-[#c1b07a] uppercase mb-2"
          >
            Dress Code
          </span>
          <p
            class="font-elegante text-xl md:text-2xl text-white tracking-widest uppercase mb-1 drop-shadow-sm"
          >
            Formal
          </p>
          <div class="flex items-center gap-2 mt-2 text-slate-300">
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#D4AF37"
              stroke-width="1.5"
            >
              <path d="M6 3h12l2 6-8 12-8-12 2-6z"></path>
            </svg>
            <span class="text-xs md:text-sm italic font-light tracking-wide">
              <span class="es-content">Traje o Vestido de Gala</span>
              <span class="en-content">Suit or Evening Gown</span>
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* 🟢 ANIMACIÓN DE REVELADO */
  .scroll-reveal {
    opacity: 0;
    transform: translateY(30px);
    transition: all 1s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .scroll-reveal.active {
    opacity: 1;
    transform: translateY(0);
  }

  /* Delays */
  .delay-200 {
    transition-delay: 0.2s;
  }
  .delay-300 {
    transition-delay: 0.3s;
  }
  .delay-500 {
    transition-delay: 0.5s;
  }

  /* 🟢 BALANCEO */
  .animate-sway {
    animation: sway 8s ease-in-out infinite;
  }
  .animate-sway-delayed {
    animation: sway 9s ease-in-out 3s infinite reverse;
  }

  @keyframes sway {
    0%,
    100% {
      transform: translateY(0) rotate(var(--tw-rotate, 0deg));
    }
    50% {
      transform: translateY(-12px) rotate(calc(var(--tw-rotate, 0deg) + 6deg));
    }
  }
</style>

<script>
  function initUbicacionesReveal() {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("active");
          }
        });
      },
      { threshold: 0.15, rootMargin: "0px 0px -50px 0px" },
    );

    document
      .querySelectorAll(".scroll-reveal")
      .forEach((el) => observer.observe(el));
  }
  document.addEventListener("DOMContentLoaded", initUbicacionesReveal);
</script>
