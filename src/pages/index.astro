---
import "../styles/global.css";
import Banner from "../components/Banner.astro";
import Cronometro from "../components/Cronometro.astro";
import PadresPadrinos from "../components/PadresPadrinos.astro";
import Ubicaciones from "../components/Ubicaciones.astro";
import Contactos from "../components/Contactos.astro";
import BabyGallery from "../components/BabyGallery.astro";
import Confirmacion from "../components/Confirmacion.astro";
import Layout from "../layouts/Layout.astro";
import AudioPlay from "../components/AudioPlay.astro";
import ComparteMomentos from "../components/ComparteMomentos.astro";
import WelcomeModal from "../components/WelcomeModal.astro"; // 🟢 IMPORTAR
import Frase from "../components/Frase.astro"; // 🟢 IMPORTAR
import Itinerario from "../components/Itinerario.astro"; // 🟢 IMPORTAR
---

<Layout>
  <WelcomeModal />
  <main class="bg-slate-50">
    <Banner />
    <Cronometro />
    <Frase />
    <PadresPadrinos />
    <Ubicaciones />
    <div class="mx-auto max-w-6xl block md:hidden pb-10 px-4 overflow-x-clip">
      <div
        class="relative w-full min-h-160 md:min-h-0 h-[55dvh] md:h-auto z-20 scroll-reveal
      border border-[#D4AF37] rounded-3xl md:border-none md:rounded-none"
      >
        {/* ENVOLTURA DE LA IMAGEN */}
        <div
          class="absolute inset-0 overflow-hidden rounded-3xl md:rounded-none md:rounded-r-[2.5rem] shadow-[0_15px_30px_rgba(0,0,0,0.5)] md:shadow-none"
        >
          <img
            src="/img/5.webp"
            alt="Lugar del evento"
            class="w-full h-full object-cover transition-transform duration-1000 hover:scale-105"
          />
          {/* Sombra interna para fusionar (Invertida para la izquierda) */}
        </div>

        {/* 🌸 FLOR DECORATIVA DE LA IMAGEN */}
        <img
          src="/img/flor3.webp"
          alt="Flor Decorativa"
          class="absolute -bottom-12 -left-8 w-36 md:w-56 rotate-45 animate-sway-delayed pointer-events-none z-30 scroll-reveal delay-500 opacity-90 drop-shadow-[0_10px_15px_rgba(0,0,0,0.6)]"
        />
      </div>
    </div>
    <Itinerario />
    <Contactos />
    <BabyGallery />
    <ComparteMomentos />
    <Confirmacion />

    <AudioPlay />
  </main>
</Layout>
